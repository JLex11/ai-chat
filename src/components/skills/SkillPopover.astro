---
---

<div class="relative" id="skill-popover-wrapper">
  <!-- Trigger Pill Button -->
  <button
    type="button"
    id="skill-popover-trigger"
    class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[var(--bg-primary)] hover:bg-[var(--border-subtle)]/70 text-[var(--text-primary)] border border-[var(--border-subtle)] shadow-2xs transition-all cursor-pointer select-none group"
    aria-haspopup="listbox"
    aria-expanded="false"
    title="Cambiar Skill o modo de ejecución"
  >
    <span class="text-indigo-500 text-xs leading-none" id="skill-pill-icon">✨</span>
    <span id="current-skill-label" class="font-medium tracking-tight truncate max-w-[110px] sm:max-w-[140px]">Skill: Auto</span>
    <svg
      id="skill-chevron"
      class="w-3 h-3 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-transform duration-200 shrink-0"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Floating Popover Dropdown Menu -->
  <div
    id="skill-popover-menu"
    class="hidden absolute bottom-full left-0 mb-2 w-72 sm:w-80 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-2xl shadow-xl p-1.5 z-50 backdrop-blur-md"
    role="listbox"
    aria-label="Seleccionar skill del asistente"
  >
    <div class="px-2.5 py-1.5 flex items-center justify-between border-b border-[var(--border-subtle)] mb-1">
      <span class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">Modos de Skill</span>
      <span class="text-[10px] font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-500/10 px-1.5 py-0.5 rounded-full" id="skill-active-badge">4 activas</span>
    </div>

    <!-- Mode Options (Auto & None) -->
    <div class="space-y-0.5 mb-1.5">
      <button
        type="button"
        class="skill-mode-btn w-full text-left p-2 rounded-xl hover:bg-[var(--bg-secondary)] transition-all flex items-start justify-between gap-2 cursor-pointer group"
        data-mode="auto"
        role="option"
      >
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-semibold text-[var(--text-primary)]">✨ Auto (Detección inteligente)</span>
            <span class="text-[9px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.2 rounded-full">Recomendado</span>
          </div>
          <p class="text-[11px] text-[var(--text-muted)] line-clamp-1 mt-0.5 leading-snug">Detecta y activa la skill adecuada según tu consulta</p>
        </div>
        <div class="skill-check-icon shrink-0 mt-0.5 text-[var(--text-primary)]" data-check-for="auto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </button>

      <button
        type="button"
        class="skill-mode-btn w-full text-left p-2 rounded-xl hover:bg-[var(--bg-secondary)] transition-all flex items-start justify-between gap-2 cursor-pointer group"
        data-mode="none"
        role="option"
      >
        <div class="min-w-0 flex-1">
          <span class="text-xs font-semibold text-[var(--text-primary)]">○ Ninguna (Asistente neutral)</span>
          <p class="text-[11px] text-[var(--text-muted)] line-clamp-1 mt-0.5 leading-snug">No aplica ninguna skill procedimental</p>
        </div>
        <div class="skill-check-icon shrink-0 mt-0.5 text-[var(--text-primary)] opacity-0" data-check-for="none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </button>
    </div>

    <!-- Active Installed Skills Quick List -->
    <div class="border-t border-[var(--border-subtle)] pt-1 mb-1">
      <div class="px-2.5 py-1 text-[10px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">
        Fijar Skill específica
      </div>
      <div id="quick-skills-list" class="space-y-0.5 max-h-40 overflow-y-auto scrollbar-thin">
        <!-- Dynamically rendered via JS -->
      </div>
    </div>

    <!-- Footer: Open Marketplace -->
    <div class="border-t border-[var(--border-subtle)] pt-1.5 px-1">
      <button
        type="button"
        id="open-marketplace-from-popover"
        class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-colors cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <span>🛍️</span>
          <span>Explorar Marketplace (skills.sh)...</span>
        </span>
        <span class="text-[10px] opacity-70">Gestionar</span>
      </button>
    </div>
  </div>
</div>
