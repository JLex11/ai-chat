---
interface Props {
  type?: 'button' | 'submit'
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger'
  size?: 'sm' | 'md' | 'lg'
  disabled?: boolean
  class?: string
  id?: string
  title?: string
}

const {
  type = 'button',
  variant = 'primary',
  size = 'md',
  disabled = false,
  class: className = '',
  id,
  title,
} = Astro.props

const baseClasses = 'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-600 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer'

const variantClasses = {
  primary: 'bg-neutral-900 hover:bg-black text-white dark:bg-white dark:hover:bg-neutral-200 dark:text-neutral-900 shadow-2xs',
  secondary: 'bg-[var(--bg-secondary)] hover:bg-[var(--border-subtle)]/70 text-[var(--text-primary)] border border-[var(--border-subtle)] shadow-2xs',
  ghost: 'bg-transparent hover:bg-[var(--border-subtle)]/60 text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
  danger: 'bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-950/40 dark:text-red-400 dark:hover:bg-red-900/40',
}

const sizeClasses = {
  sm: 'px-2.5 py-1 text-xs sm:text-sm',
  md: 'px-3.5 py-1.5 text-sm',
  lg: 'px-4 py-2 text-sm sm:text-base',
}

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`
---

<button type={type} class={classes} disabled={disabled} id={id} title={title}>
  <slot />
</button>
