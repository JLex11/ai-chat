---
import Layout from './Layout.astro'

interface Props {
  title?: string
}

const { title = 'AI Chat - Chat con IA local y privada' } = Astro.props
---

<Layout title={title}>
  <div class="flex h-[100dvh] w-full overflow-hidden bg-[var(--bg-primary)]">
    <slot name="sidebar" />
    <main class="flex-1 flex flex-col min-w-0 h-full relative overflow-hidden bg-[var(--bg-primary)]">
      <slot name="content" />
    </main>
  </div>
  <slot />
</Layout>
