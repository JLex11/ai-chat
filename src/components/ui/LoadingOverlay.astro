---
interface Props {
  id?: string
}

const { id = 'loading-overlay' } = Astro.props
---

<div
  id={id}
  class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 hidden transition-opacity duration-200"
>
  <div class="bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-7 max-w-md w-full mx-4 shadow-2xl text-[var(--text-primary)] animate-fade-in">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-8 h-8 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <div>
        <h2 class="text-base font-semibold text-[var(--text-primary)]">Cargando modelo local</h2>
        <p class="text-xs text-[var(--text-secondary)]" id="loading-model-name">Iniciando motor WebLLM...</p>
      </div>
    </div>

    <div class="relative h-2 bg-[var(--bg-secondary)] rounded-full overflow-hidden my-4 border border-[var(--border-subtle)]">
      <div
        id="progress-bar"
        class="absolute inset-y-0 left-0 bg-neutral-900 dark:bg-white rounded-full transition-all duration-200"
        style="width: 0%"
      ></div>
    </div>

    <div class="flex justify-between text-xs text-[var(--text-secondary)] mb-3">
      <span id="progress-text" class="font-medium">0%</span>
      <span id="progress-status" class="truncate max-w-[240px]">Descargando archivos...</span>
    </div>

    <p class="text-[11px] text-[var(--text-muted)] text-center">
      El modelo se guarda en la memoria caché del navegador (IndexedDB) para su reutilización sin conexión.
    </p>
  </div>
</div>
