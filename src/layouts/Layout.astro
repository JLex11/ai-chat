---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="AI Chat - Chat con Inteligencia Artificial local y privada en tu navegador" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link
      href="/ollama_light.svg"
      rel="icon"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      href="/ollama_dark.svg"
      rel="icon"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:image" content="/ai-chat.webp" />

    <script is:inline>
      (function() {
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const qTheme = urlParams.get('theme');
          if (qTheme === 'dark') {
            document.documentElement.classList.add('dark');
            return;
          } else if (qTheme === 'light') {
            document.documentElement.classList.remove('dark');
            return;
          }
          const prefsStr = localStorage.getItem('ai-chat-preferences');
          let theme = 'light';
          if (prefsStr) {
            const prefs = JSON.parse(prefsStr);
            if (prefs && prefs.theme) {
              theme = prefs.theme;
            }
          }
          const themeStr = localStorage.getItem('ai-chat-theme');
          if (themeStr) {
            theme = themeStr;
          }
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
</style>
