---
import ChatContainer from '../components/chat/ChatContainer.astro'
import Sidebar from '../components/sidebar/Sidebar.astro'
import LoadingOverlay from '../components/ui/LoadingOverlay.astro'
import SkillsModal from '../components/skills/SkillsModal.astro'
import ChatLayout from '../layouts/ChatLayout.astro'
import type { Message } from '../scripts/chat/types'

const isDemo = Astro.url.searchParams.get('demo') === '1'

const demoMessages: Message[] = isDemo
  ? [
      {
        id: 'msg_1',
        role: 'user',
        content: '¿Puedes explicarme cómo implementar un debounce en TypeScript y mostrarme un ejemplo práctico con una tabla comparativa?',
        timestamp: Date.now() - 60000,
      },
      {
        id: 'msg_2',
        role: 'assistant',
        reasoningSteps: [
          {
            step: 'planning',
            title: 'Planificación de objetivos clave',
            content: '- Explicar concepto base de debounce vs throttle.\n- Proporcionar implementación TypeScript genérica limpia.\n- Resumir diferencias críticas en tabla Markdown.',
          },
          {
            step: 'draft',
            title: 'Borrador de respuesta estructurada',
            content: 'Generando explicación técnica y snippet tipado.',
          },
          {
            step: 'validation',
            title: 'Validación de código y formato',
            content: 'APROBADO',
          },
          {
            step: 'refinement',
            title: 'Respuesta pulida y optimizada',
            content: 'Borrador validado correctamente sin repeticiones.',
          },
        ],
        content: `<p>El patrón <strong>debounce</strong> asegura que una función no se ejecute repetidamente hasta que haya transcurrido un tiempo de espera determinado desde la última invocación.</p>
<h3>Implementación en TypeScript</h3>
<p>Aquí tienes una implementación robusta con genéricos:</p>
<div class="code-block my-4 rounded-xl overflow-hidden border border-neutral-200/80 dark:border-neutral-800 bg-[#1e1e22] shadow-sm">
  <div class="flex items-center justify-between px-4 py-2 bg-[#2d2d34] text-xs text-neutral-300 font-mono select-none">
    <span class="font-medium text-neutral-300">typescript</span>
    <button type="button" class="copy-code-btn inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-neutral-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" title="Copiar código">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
      <span>Copiar</span>
    </button>
  </div>
  <div class="code-content text-sm p-4 text-emerald-400 font-mono overflow-x-auto">
    <pre><code>export function debounce&lt;T extends (...args: any[]) =&gt; void&gt;(
  fn: T,
  delayMs: number
): (...args: Parameters&lt;T&gt;) =&gt; void &#123;
  let timerId: ReturnType&lt;typeof setTimeout&gt; | null = null;

  return (...args: Parameters&lt;T&gt;) =&gt; &#123;
    if (timerId !== null) &#123;
      clearTimeout(timerId);
    &#125;
    timerId = setTimeout(() =&gt; &#123;
      fn(...args);
      timerId = null;
    &#125;, delayMs);
  &#125;;
&#125;</code></pre>
  </div>
</div>
<h3>Comparativa: Debounce vs Throttle</h3>
<table>
<thead>
<tr>
<th>Patrón</th>
<th>Comportamiento</th>
<th>Caso de uso ideal</th>
</tr>
</thead>
<tbody>
<tr>
<td><strong>Debounce</strong></td>
<td>Espera a que cese la ráfaga de llamadas</td>
<td>Búsquedas en tiempo real, autoguardado</td>
</tr>
<tr>
<td><strong>Throttle</strong></td>
<td>Ejecuta como máximo una vez cada intervalo fijo</td>
<td>Scroll infinito, resize de ventana</td>
</tr>
</tbody>
</table>
<p>Todo este procesamiento y renderizado se ejecuta <strong>100% en local</strong> en tu equipo.</p>`,
        timestamp: Date.now() - 30000,
      },
    ]
  : []

const demoConversations = isDemo
  ? [{ id: 'demo_conversation', title: 'Ejemplo de debounce en TypeScript', isActive: true }]
  : []
---

<ChatLayout title='AI Chat - Chat con IA local y privada'>
  <Sidebar slot='sidebar' initialConversations={demoConversations} />
  <div slot='content' class='flex flex-col h-full w-full min-w-0'>
    <ChatContainer initialMessages={demoMessages} />
  </div>
  <LoadingOverlay />
  <SkillsModal />
</ChatLayout>

<script>
  import { initChat, sendMessage, switchModel, getCurrentModelId, checkIfModelIsCached, stopGeneration } from '../scripts/chat/engine'
  import { runAgenticPipeline, abortPipeline, isTrivialQuery } from '../scripts/chat/pipeline'
  import { renderMarkdown, initMarkdown, createStreamingRenderer } from '../scripts/utils/markdown'
  import { getSelectedModel, setSelectedModel, getTheme, setTheme, getRefinementMode, setRefinementMode } from '../scripts/storage/preferences'
  import {
    loadConversations,
    saveConversation,
    deleteConversation,
    createConversation,
    updateConversationTitle,
    addMessageToConversation,
    getCurrentConversationId,
    setCurrentConversationId,
    getConversation,
    groupConversationsByPeriod,
  } from '../scripts/storage/conversations'
  import { getModelById } from '../scripts/config/models'
  import type { Conversation, Message, ReasoningStep } from '../scripts/chat/types'
  import {
    getInstalledSkills,
    getSkillMode,
    setSkillMode,
    toggleSkillEnabled,
    deleteSkill,
    isSkillInstalled,
    installFromCatalog,
    getSkillById,
    getActiveSkills,
    saveSkill,
  } from '../scripts/skills/storage'
  import { SKILLS_CATALOG } from '../scripts/skills/catalog'
  import { matchSkillForPrompt } from '../scripts/skills/matcher'
  import { importSkillFromGitHub, parseSkillMarkdown } from '../scripts/skills/importer'
  import type { Skill, SkillCatalogItem, SkillMode } from '../scripts/skills/types'
  import {
    attachDocument,
    removeDocument,
    subscribeToDocuments,
    hasAttachedDocuments,
    extractTextFromPdf,
  } from '../scripts/tools'
  import type { AttachedDocument } from '../scripts/tools/types'

  // DOM Elements
  const $loadingOverlay = document.getElementById('loading-overlay')!
  const $loadingModelName = document.getElementById('loading-model-name')!
  const $progressBar = document.getElementById('progress-bar')!
  const $progressText = document.getElementById('progress-text')!
  const $progressStatus = document.getElementById('progress-status')!

  const $form = document.getElementById('chat-form') as HTMLFormElement
  const $input = document.getElementById('message-input') as HTMLTextAreaElement
  const $sendBtn = document.getElementById('send-btn') as HTMLButtonElement
  const $sendIcon = document.getElementById('send-icon')!
  const $stopIcon = document.getElementById('stop-icon')!
  const $modelStatus = document.getElementById('model-status')!
  const $modelStatusDot = document.getElementById('model-status-dot')
  const $modelSelect = document.getElementById('model-select') as HTMLInputElement | HTMLSelectElement | null
  const $themeToggle = document.getElementById('theme-toggle')

  // Tools & Documents
  const $fileUploadInput = document.getElementById('file-upload-input') as HTMLInputElement | null
  const $attachedFilesContainer = document.getElementById('attached-files-container')

  // Refinement Mode Controls
  const $refinementToggleBtn = document.getElementById('refinement-toggle-btn') as HTMLButtonElement | null
  const $refinementIndicator = document.getElementById('refinement-indicator')

  function updateRefinementUI(enabled: boolean) {
    if (!$refinementToggleBtn) return
    $refinementToggleBtn.setAttribute('aria-pressed', enabled ? 'true' : 'false')
    if (enabled) {
      $refinementToggleBtn.classList.add(
        'bg-amber-500/10',
        'text-amber-600',
        'dark:text-amber-400',
        'border-amber-500/30',
        'hover:bg-amber-500/15'
      )
      $refinementToggleBtn.classList.remove(
        'bg-[var(--bg-primary)]',
        'text-[var(--text-secondary)]',
        'border-[var(--border-subtle)]'
      )
      $refinementIndicator?.classList.remove('hidden')
    } else {
      $refinementToggleBtn.classList.remove(
        'bg-amber-500/10',
        'text-amber-600',
        'dark:text-amber-400',
        'border-amber-500/30',
        'hover:bg-amber-500/15'
      )
      $refinementToggleBtn.classList.add(
        'bg-[var(--bg-primary)]',
        'text-[var(--text-secondary)]',
        'border-[var(--border-subtle)]'
      )
      $refinementIndicator?.classList.add('hidden')
    }
  }

  function initRefinementToggle() {
    const isEnabled = getRefinementMode()
    updateRefinementUI(isEnabled)

    $refinementToggleBtn?.addEventListener('click', () => {
      const next = !getRefinementMode()
      setRefinementMode(next)
      updateRefinementUI(next)
    })
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
  }

  function getFileBadgeInfo(name: string): { icon: string; tag: string; colorClass: string } {
    const lower = name.toLowerCase()
    if (lower.endsWith('.pdf')) {
      return { icon: '📕', tag: 'PDF', colorClass: 'bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/20' }
    }
    if (lower.endsWith('.csv')) {
      return { icon: '📊', tag: 'CSV', colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20' }
    }
    if (lower.endsWith('.json')) {
      return { icon: '📦', tag: 'JSON', colorClass: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20' }
    }
    if (lower.endsWith('.md') || lower.endsWith('.markdown')) {
      return { icon: '📝', tag: 'MD', colorClass: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20' }
    }
    if (lower.endsWith('.py') || lower.endsWith('.js') || lower.endsWith('.ts') || lower.endsWith('.html') || lower.endsWith('.css')) {
      return { icon: '💻', tag: 'CODE', colorClass: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20' }
    }
    return { icon: '📄', tag: 'DOC', colorClass: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20' }
  }

  function renderAttachedFiles(docs: AttachedDocument[]) {
    if (!$attachedFilesContainer) return
    if (docs.length === 0) {
      $attachedFilesContainer.classList.add('hidden')
      $attachedFilesContainer.innerHTML = ''
      updateSendButtonState()
      return
    }

    $attachedFilesContainer.classList.remove('hidden')
    $attachedFilesContainer.innerHTML = docs
      .map(doc => {
        const badge = getFileBadgeInfo(doc.name)
        return `
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs ${badge.colorClass} border select-none shadow-2xs">
        <span class="text-xs">${badge.icon}</span>
        <span class="font-medium truncate max-w-[130px] sm:max-w-[180px]" title="${escapeHtml(doc.name)}">${escapeHtml(doc.name)}</span>
        <span class="text-[9px] px-1 py-0.2 rounded font-mono font-semibold uppercase opacity-85">${badge.tag}</span>
        <span class="text-[10px] opacity-75 font-mono">(${formatBytes(doc.size)})</span>
        <button
          type="button"
          class="remove-doc-btn hover:text-red-500 ml-1 p-0.5 rounded cursor-pointer transition-colors"
          data-id="${doc.id}"
          title="Eliminar documento adjunto"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    `
      })
      .join('')

    $attachedFilesContainer.querySelectorAll('.remove-doc-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation()
        const id = (btn as HTMLElement).dataset.id
        if (id) {
          removeDocument(id)
        }
      })
    })

    updateSendButtonState()
  }

  function initToolsUI() {
    subscribeToDocuments(renderAttachedFiles)

    $fileUploadInput?.addEventListener('change', async () => {
      const files = $fileUploadInput.files
      if (!files || files.length === 0) return

      for (let i = 0; i < files.length; i++) {
        const file = files[i]
        try {
          let text = ''
          const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf'
          if (isPdf) {
            const buffer = await file.arrayBuffer()
            text = await extractTextFromPdf(buffer)
            if (!text.trim()) {
              text = `[Documento PDF "${file.name}" cargado (${formatBytes(file.size)}), pero no se detectaron capas de texto digital. Puede contener imágenes o escaneos sin OCR.]`
            }
          } else {
            text = await file.text()
          }
          attachDocument(file.name, text, isPdf ? 'application/pdf' : (file.type || 'text/plain'))
        } catch (err: any) {
          console.error('Error al leer el archivo adjunto:', err)
          alert(`No se pudo procesar el archivo "${file.name}": ${err.message || 'Error de lectura'}`)
        }
      }

      $fileUploadInput.value = ''
      updateSendButtonState()
      $input?.focus()
    })
  }

  // Redesigned Custom Controls: Model Popover
  const $modelPopoverTrigger = document.getElementById('model-popover-trigger')
  const $modelPopoverMenu = document.getElementById('model-popover-menu')
  const $modelChevron = document.getElementById('model-chevron')
  const $currentModelName = document.getElementById('current-model-name')
  const $currentModelSize = document.getElementById('current-model-size')
  const modelOptionBtns = document.querySelectorAll<HTMLButtonElement>('.model-option-btn')

  // Skills Controls & Popover
  const $skillPopoverTrigger = document.getElementById('skill-popover-trigger')
  const $skillPopoverMenu = document.getElementById('skill-popover-menu')
  const $skillChevron = document.getElementById('skill-chevron')
  const $currentSkillLabel = document.getElementById('current-skill-label')
  const $skillPillIcon = document.getElementById('skill-pill-icon')
  const $skillActiveBadge = document.getElementById('skill-active-badge')
  const $quickSkillsList = document.getElementById('quick-skills-list')
  const $openMarketplaceFromPopover = document.getElementById('open-marketplace-from-popover')
  const skillModeBtns = document.querySelectorAll<HTMLButtonElement>('.skill-mode-btn')

  // Skills Marketplace Modal Elements
  const $skillsModal = document.getElementById('skills-modal')
  const $closeSkillsModal = document.getElementById('close-skills-modal')
  const $openSkillsMarketplaceBtn = document.getElementById('open-skills-marketplace-btn')
  const $sidebarSkillsCount = document.getElementById('sidebar-skills-count')
  const $tabInstalledCount = document.getElementById('tab-installed-count')

  // Modal Tab Switching
  const skillsTabBtns = document.querySelectorAll<HTMLButtonElement>('.skills-tab-btn')
  const $tabPanelMarketplace = document.getElementById('tab-panel-marketplace')
  const $tabPanelInstalled = document.getElementById('tab-panel-installed')
  const $tabPanelImport = document.getElementById('tab-panel-import')

  // Marketplace tab controls
  const $marketplaceSearchInput = document.getElementById('marketplace-search-input') as HTMLInputElement | null
  const categoryFilterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn')
  const leaderboardViewBtns = document.querySelectorAll<HTMLButtonElement>('.leaderboard-view-btn')
  const $liveApiDot = document.getElementById('live-api-dot')
  const $liveApiStatusText = document.getElementById('live-api-status-text')
  const $marketplaceLoadingState = document.getElementById('marketplace-loading-state')
  const $marketplaceCardsGrid = document.getElementById('marketplace-cards-grid')
  const $marketplaceEmptyResults = document.getElementById('marketplace-empty-results')

  // Installed tab controls
  const $installedSkillsList = document.getElementById('installed-skills-list')
  const $installedEmptyState = document.getElementById('installed-empty-state')

  // Import tab controls
  const $githubImportForm = document.getElementById('github-import-form') as HTMLFormElement | null
  const $githubRepoInput = document.getElementById('github-repo-input') as HTMLInputElement | null
  const $githubImportBtn = document.getElementById('github-import-btn') as HTMLButtonElement | null
  const $githubImportStatus = document.getElementById('github-import-status')
  const $customSkillForm = document.getElementById('custom-skill-form') as HTMLFormElement | null
  const $customSkillName = document.getElementById('custom-skill-name') as HTMLInputElement | null
  const $customSkillTags = document.getElementById('custom-skill-tags') as HTMLInputElement | null
  const $customSkillDesc = document.getElementById('custom-skill-desc') as HTMLInputElement | null
  const $customSkillTriggers = document.getElementById('custom-skill-triggers') as HTMLInputElement | null
  const $customSkillPrompt = document.getElementById('custom-skill-prompt') as HTMLTextAreaElement | null

  // Skill preview modal
  const $skillPreviewModal = document.getElementById('skill-preview-modal')
  const $closeSkillPreview = document.getElementById('close-skill-preview')
  const $previewSkillTitle = document.getElementById('preview-skill-title')
  const $previewSkillRepo = document.getElementById('preview-skill-repo')
  const $previewSkillIcon = document.getElementById('preview-skill-icon')
  const $previewSkillDesc = document.getElementById('preview-skill-desc')
  const $previewSkillPrompt = document.getElementById('preview-skill-prompt')
  const $previewCopyBtn = document.getElementById('preview-copy-btn') as HTMLButtonElement | null
  const $previewActionBtn = document.getElementById('preview-action-btn') as HTMLButtonElement | null

  const $messageList = document.getElementById('message-list')!
  const $messages = document.getElementById('messages')!
  const $emptyState = document.getElementById('empty-state')!
  const $typingIndicator = document.getElementById('typing-indicator')!
  const $scrollBottomBtn = document.getElementById('scroll-bottom-btn')
  const $chatContainer = document.getElementById('chat-container')

  const $sidebar = document.getElementById('sidebar')!
  const $sidebarOverlay = document.getElementById('sidebar-overlay')!
  const $toggleSidebar = document.getElementById('toggle-sidebar')!
  const $closeSidebar = document.getElementById('close-sidebar')!
  const $conversationsList = document.getElementById('conversations-list')!
  const $noConversations = document.getElementById('no-conversations')!

  const $newChatBtn = document.getElementById('new-chat-btn')!
  const $newChatSidebar = document.getElementById('new-chat-sidebar')!

  // State
  let currentConversation: Conversation | null = null
  let chatMessages: Message[] = []
  let isGenerating = false
  let userScrolledUp = false

  // Initialize
  async function init() {
    initTheme()
    initRefinementToggle()
    initToolsUI()
    initSkills()
    updateSidebarState()
    window.addEventListener('resize', updateSidebarState)

    const savedModel = getSelectedModel()
    updateModelUI(savedModel)

    const isCached = await checkIfModelIsCached(savedModel)
    const modelConfig = getModelById(savedModel)
    if (modelConfig && $loadingModelName) {
      $loadingModelName.textContent = isCached
        ? `${modelConfig.name} (en caché local)`
        : `${modelConfig.name} (${modelConfig.size})`
    }

    // Check for demo param for automated verification / preview
    const urlParams = new URLSearchParams(window.location.search)
    const isDemo = urlParams.get('demo') === '1'

    if (isDemo) {
      if (urlParams.get('popover') === '1') {
        toggleModelPopover(true)
      }
      currentConversation = {
        id: 'demo_conversation',
        title: 'Ejemplo de debounce en TypeScript',
        messages: [
          {
            id: 'msg_1',
            role: 'user',
            content: '¿Puedes explicarme cómo implementar un debounce en TypeScript y mostrarme un ejemplo práctico con una tabla comparativa?',
            timestamp: Date.now() - 60000,
          },
          {
            id: 'msg_2',
            role: 'assistant',
            reasoningSteps: [
              {
                step: 'planning',
                title: 'Planificación de objetivos clave',
                content: '- Explicar concepto base de debounce vs throttle.\n- Proporcionar implementación TypeScript genérica limpia.\n- Resumir diferencias críticas en tabla Markdown.',
              },
              {
                step: 'draft',
                title: 'Borrador de respuesta estructurada',
                content: 'Generando explicación técnica y snippet tipado.',
              },
              {
                step: 'validation',
                title: 'Validación de código y formato',
                content: 'APROBADO',
              },
              {
                step: 'refinement',
                title: 'Respuesta pulida y optimizada',
                content: 'Borrador validado correctamente sin repeticiones.',
              },
            ],
            content: `El patrón **debounce** asegura que una función no se ejecute repetidamente hasta que haya transcurrido un tiempo de espera determinado desde la última invocación.

### Implementación en TypeScript

Aquí tienes una implementación robusta con genéricos:

\`\`\`typescript
export function debounce<T extends (...args: any[]) => void>(
  fn: T,
  delayMs: number
): (...args: Parameters<T>) => void {
  let timerId: ReturnType<typeof setTimeout> | null = null;

  return (...args: Parameters<T>) => {
    if (timerId !== null) {
      clearTimeout(timerId);
    }
    timerId = setTimeout(() => {
      fn(...args);
      timerId = null;
    }, delayMs);
  };
}
\`\`\`

### Comparativa: Debounce vs Throttle

| Patrón | Comportamiento | Caso de uso ideal |
| :--- | :--- | :--- |
| **Debounce** | Espera a que cese la ráfaga de llamadas | Búsquedas en tiempo real, autoguardado |
| **Throttle** | Ejecuta como máximo una vez cada intervalo fijo | Scroll infinito, resize de ventana |

Todo este procesamiento y renderizado se ejecuta **100% en local** en tu equipo.`,
            timestamp: Date.now() - 30000,
          },
        ],
        modelUsed: savedModel,
        createdAt: Date.now() - 60000,
        updatedAt: Date.now() - 30000,
      }
      chatMessages = currentConversation.messages.filter(m => m.role !== 'system')
      setCurrentConversationId(currentConversation.id)
      saveConversation(currentConversation)
      renderMessages()
    } else {
      // Always load/create conversation first
      const savedConversationId = getCurrentConversationId()
      if (savedConversationId) {
        const conv = getConversation(savedConversationId)
        if (conv) {
          loadConversation(conv)
        } else {
          startNewConversation()
        }
      } else {
        startNewConversation()
      }
    }
    renderConversationsList()

    // Initialize highlighter in background
    initMarkdown().then(() => {
      if (chatMessages.length > 0) {
        renderMessages()
      }
    })

    if (!isDemo) {
      showLoadingOverlay()

      try {
        await initChat(onProgress)
        hideLoadingOverlay()
        updateModelStatus('ready', 'Listo')
        updateSendButtonState()
      } catch (error) {
        console.error('Error initializing chat:', error)
        hideLoadingOverlay()
        updateModelStatus('error', 'Error al cargar')
        updateSendButtonState()
      }
    } else {
      updateModelStatus('ready', 'Listo')
      updateSendButtonState()
    }
  }

  // Theme Management
  function initTheme() {
    const activeTheme = getTheme()
    applyTheme(activeTheme)

    $themeToggle?.addEventListener('click', () => {
      const current = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
      const next = current === 'dark' ? 'light' : 'dark'
      setTheme(next)
      applyTheme(next)
    })
  }

  function applyTheme(theme: 'light' | 'dark') {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
  }

  function onProgress(info: { text: string; progress: number }) {
    const percent = Math.round(info.progress * 100)
    if ($progressBar) $progressBar.style.width = `${percent}%`
    if ($progressText) $progressText.textContent = `${percent}%`
    if ($progressStatus) $progressStatus.textContent = info.text
    updateModelStatus('loading', `Cargando ${percent}%`)
  }

  function updateModelStatus(status: 'ready' | 'loading' | 'generating' | 'error', text: string) {
    if ($modelStatus) $modelStatus.textContent = text
    if (!$modelStatusDot) return

    $modelStatusDot.className = 'w-1.5 h-1.5 rounded-full'
    if (status === 'ready') {
      $modelStatusDot.classList.add('bg-emerald-500')
    } else if (status === 'loading') {
      $modelStatusDot.classList.add('bg-amber-500', 'animate-pulse')
    } else if (status === 'generating') {
      $modelStatusDot.classList.add('bg-blue-500', 'animate-pulse')
    } else if (status === 'error') {
      $modelStatusDot.classList.add('bg-red-500')
    }
  }

  function showLoadingOverlay() {
    $loadingOverlay?.classList.remove('hidden')
  }

  function hideLoadingOverlay() {
    $loadingOverlay?.classList.add('hidden')
  }

  // Sidebar (Desktop Collapse + Mobile Overlay)
  function updateSidebarState() {
    const isMobile = window.innerWidth < 1024
    if (!isMobile) {
      const isCollapsed = $sidebar.classList.contains('sidebar-desktop-collapsed')
      if (isCollapsed) {
        $toggleSidebar?.classList.remove('lg:hidden')
      } else {
        $toggleSidebar?.classList.add('lg:hidden')
      }
    } else {
      $toggleSidebar?.classList.remove('lg:hidden')
    }
  }

  function toggleSidebar() {
    const isMobile = window.innerWidth < 1024
    if (isMobile) {
      $sidebar.classList.toggle('-translate-x-full')
      $sidebarOverlay.classList.toggle('hidden')
    } else {
      $sidebar.classList.toggle('sidebar-desktop-collapsed')
      updateSidebarState()
    }
  }

  function closeSidebar() {
    const isMobile = window.innerWidth < 1024
    if (isMobile) {
      $sidebar.classList.add('-translate-x-full')
      $sidebarOverlay.classList.add('hidden')
    } else {
      $sidebar.classList.add('sidebar-desktop-collapsed')
      updateSidebarState()
    }
  }

  $toggleSidebar?.addEventListener('click', toggleSidebar)
  $closeSidebar?.addEventListener('click', closeSidebar)
  $sidebarOverlay?.addEventListener('click', closeSidebar)

  // Smart Scrolling & Button
  function scrollToBottom(smooth = true) {
    if (!$messages) return
    const maxScroll = $messages.scrollHeight - $messages.clientHeight
    if (maxScroll <= 0) {
      $messages.scrollTop = 0
      userScrolledUp = false
      updateScrollButtonVisibility()
      return
    }
    if (smooth) {
      $messages.scrollTo({ top: $messages.scrollHeight, behavior: 'smooth' })
    } else {
      $messages.scrollTop = $messages.scrollHeight
    }
    userScrolledUp = false
    updateScrollButtonVisibility()
  }

  function checkScrollPosition() {
    if (!$messages) return
    const distanceToBottom = $messages.scrollHeight - $messages.scrollTop - $messages.clientHeight
    userScrolledUp = distanceToBottom > 80
    updateScrollButtonVisibility()
  }

  function updateScrollButtonVisibility() {
    if (!$scrollBottomBtn) return
    if (userScrolledUp && chatMessages.length > 0) {
      $scrollBottomBtn.classList.remove('hidden')
    } else {
      $scrollBottomBtn.classList.add('hidden')
    }
  }

  $messages?.addEventListener('scroll', checkScrollPosition, { passive: true })
  $scrollBottomBtn?.addEventListener('click', () => scrollToBottom(true))

  // Conversations Management
  function startNewConversation() {
    const modelId = getCurrentModelId() ?? getSelectedModel()
    currentConversation = createConversation(modelId)
    chatMessages = []
    setCurrentConversationId(currentConversation.id)
    renderMessages()
    renderConversationsList()
    if (window.innerWidth < 1024) closeSidebar()
    $input?.focus()
  }

  function loadConversation(conv: Conversation) {
    currentConversation = conv
    chatMessages = conv.messages.filter(m => m.role !== 'system')
    setCurrentConversationId(conv.id)
    renderMessages()
    renderConversationsList()
    if (window.innerWidth < 1024) closeSidebar()
  }

  function renderMessages() {
    $messageList.innerHTML = ''

    if (chatMessages.length === 0) {
      $emptyState.classList.remove('hidden')
      $chatContainer?.classList.add('is-empty')
    } else {
      $emptyState.classList.add('hidden')
      $chatContainer?.classList.remove('is-empty')

      chatMessages.forEach(msg => {
        if (msg.role === 'system') return
        addMessageToDOM(msg.content, msg.role as 'user' | 'assistant', msg.skillUsed, msg.reasoningSteps)
      })
    }

    console.error('--- RENDER MESSAGES COUNT:', chatMessages.length, '$messageList children:', $messageList.children.length, '$messages scrollHeight:', $messages.scrollHeight, '$messages clientHeight:', $messages.clientHeight)

    scrollToBottom(false)
  }

  function hydrateReasoningMarkdown(container: HTMLElement) {
    const elements = container.querySelectorAll<HTMLElement>('.step-markdown-content[data-content]')
    elements.forEach(async el => {
      const raw = el.dataset.content
      if (raw) {
        const decoded = decodeURIComponent(raw)
        try {
          const html = await renderMarkdown(decoded)
          el.innerHTML = html
          delete el.dataset.content
        } catch (err) {
          console.warn('Error al renderizar markdown de razonamiento:', err)
        }
      }
    })
  }

  function renderReasoningAccordionHtml(steps?: ReasoningStep[]): string {
    if (!steps || steps.length === 0) return ''
    const itemsHtml = steps
      .map(step => {
        let icon = '📋'
        let badge = 'PLANIFICACIÓN'
        if (step.step === 'tools') {
          icon = '🛠️'
          badge = 'HERRAMIENTAS'
        }
        if (step.step === 'draft') {
          icon = '📝'
          badge = 'BORRADOR'
        }
        if (step.step === 'validation') {
          icon = '🔍'
          badge = 'VALIDACIÓN'
        }
        if (step.step === 'refinement') {
          icon = '✨'
          badge = 'REFINAMIENTO'
        }
        return `
        <div class="space-y-0.5">
          <div class="flex items-center justify-between text-[11px] font-medium text-[var(--text-muted)]">
            <span class="flex items-center gap-1.5 text-[var(--text-secondary)] font-medium">
              <span class="text-[11px]">${icon}</span>
              <span>${escapeHtml(step.title)}</span>
            </span>
            <span class="text-[9px] font-mono text-[var(--text-muted)] opacity-75 uppercase tracking-wider">${badge}</span>
          </div>
          <div class="step-markdown-content reasoning-prose pl-2 border-l border-amber-500/25 select-text" data-content="${encodeURIComponent(step.content)}">
            <div class="whitespace-pre-wrap">${escapeHtml(step.content)}</div>
          </div>
        </div>
      `
      })
      .join('')

    return `
      <details class="reasoning-accordion group/reason text-xs">
        <summary class="flex items-center justify-between py-1 cursor-pointer select-none text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-500/80 text-xs">🧠</span>
            <span class="font-medium text-[11.5px] text-[var(--text-muted)] hover:text-[var(--text-secondary)]">Proceso de razonamiento y herramientas</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded-full bg-[var(--bg-secondary)] border border-[var(--border-subtle)] text-[var(--text-muted)] font-mono opacity-80">${steps.length} fases</span>
          </div>
          <div class="flex items-center gap-1.5 text-[var(--text-muted)] opacity-70">
            <svg class="w-3 h-3 group-open/reason:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>
        <div class="w-full border-t border-[var(--border-subtle)]/60 my-1"></div>
        <div class="py-0.5 space-y-2">
          ${itemsHtml}
        </div>
      </details>
      <hr class="border-t border-[var(--border-subtle)]/60 my-3" />
    `
  }

  function addMessageToDOM(
    content: string,
    role: 'user' | 'assistant',
    skillUsed?: { id: string; name: string; icon?: string } | null,
    reasoningSteps?: ReasoningStep[]
  ) {
    $emptyState.classList.add('hidden')
    $chatContainer?.classList.remove('is-empty')

    const li = document.createElement('li')
    li.dataset.role = role
    li.className = `message w-full group transition-colors duration-150 ${
      role === 'user' ? 'flex justify-end' : 'flex flex-col'
    }`

    if (role === 'user') {
      li.innerHTML = `
        <div class="user-bubble bg-[var(--user-msg-bg)] text-[var(--user-msg-text)] rounded-[22px] px-4.5 py-3 max-w-[85%] sm:max-w-[75%] text-[15px] leading-relaxed break-words shadow-2xs">
          <div class="message-content whitespace-pre-wrap">${escapeHtml(content)}</div>
        </div>
      `
      $messageList.appendChild(li)
      return li.querySelector('.message-content')!
    } else {
      const skillBadgeHtml = skillUsed
        ? `<div class="skill-badge inline-flex items-center gap-1.5 px-2.5 py-0.5 mb-2 rounded-full text-[11px] font-medium bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 select-none">
            <span>${skillUsed.icon || '✨'}</span>
            <span>Skill: ${escapeHtml(skillUsed.name)}</span>
          </div>`
        : ''

      li.innerHTML = `
        <div class="assistant-wrapper w-full">
          ${skillBadgeHtml}
          <div class="pipeline-live-tracker hidden text-xs transition-opacity duration-300">
            <div class="flex items-center justify-between py-1 select-none">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="text-amber-500/80 text-xs animate-pulse">🧠</span>
                <span class="font-medium text-[11.5px] text-[var(--text-muted)]">Pensamiento</span>
                <span class="live-step-badge px-1.5 py-0.2 rounded-full text-[9px] font-mono font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400">
                  1/3 PLANIFICAR
                </span>
                <span class="live-step-label text-[11px] text-[var(--text-muted)] opacity-75 truncate hidden sm:inline">
                  Iniciando análisis...
                </span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-[10px] font-mono text-amber-600/80 dark:text-amber-400/80 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                  Streaming
                </span>
                <button
                  type="button"
                  class="toggle-thought-btn text-[var(--text-muted)] hover:text-[var(--text-primary)] p-0.5 rounded transition-colors cursor-pointer"
                  title="Ocultar / Mostrar pensamiento"
                >
                  <svg class="w-3 h-3 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Línea divisora -->
            <div class="w-full border-t border-[var(--border-subtle)]/60 my-1"></div>

            <!-- Contenido con Markdown (compacto, line-height ajustado y opacidad sutil) -->
            <div class="live-thought-body py-0.5 reasoning-prose">
              <div class="live-thought-content"></div>
            </div>

            <!-- Separador con el output final -->
            <hr class="border-t border-[var(--border-subtle)]/60 my-3" />
          </div>
          <div class="reasoning-container">
            ${renderReasoningAccordionHtml(reasoningSteps)}
          </div>
          <div class="message-content prose max-w-none text-[var(--text-primary)] text-[15px] sm:text-[16px] leading-[1.68]"></div>
          <div class="message-actions flex items-center gap-1 mt-2.5 opacity-0 group-hover:opacity-100 transition-opacity">
            <button
              type="button"
              class="copy-btn inline-flex items-center gap-1.5 px-2 py-1 text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--border-subtle)]/60 rounded-md transition-colors cursor-pointer"
              title="Copiar respuesta"
            >
              <svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="copy-text">Copiar</span>
            </button>
          </div>
        </div>
      `

      const $content = li.querySelector('.message-content') as HTMLElement
      const $liveTracker = li.querySelector('.pipeline-live-tracker') as HTMLElement | null
      const $liveStepBadge = li.querySelector('.live-step-badge') as HTMLElement | null
      const $liveStepLabel = li.querySelector('.live-step-label') as HTMLElement | null
      const $thoughtBody = li.querySelector('.live-thought-body') as HTMLElement | null
      const $thoughtContent = li.querySelector('.live-thought-content') as HTMLElement | null
      const $reasoningContainer = li.querySelector('.reasoning-container') as HTMLElement | null
      const $toggleThoughtBtn = li.querySelector('.toggle-thought-btn') as HTMLButtonElement | null

      let currentStepKey = ''
      let accumulatedThoughtMarkdown = ''
      let thoughtStreamer: ReturnType<typeof createStreamingRenderer> | null = null

      if ($thoughtContent) {
        thoughtStreamer = createStreamingRenderer(html => {
          $thoughtContent.innerHTML = html
          if (!userScrolledUp) {
            scrollToBottom(false)
          }
        })
      }

      $toggleThoughtBtn?.addEventListener('click', () => {
        if ($thoughtBody) {
          const isCollapsed = $thoughtBody.classList.toggle('hidden')
          $toggleThoughtBtn.querySelector('svg')?.classList.toggle('rotate-180', isCollapsed)
        }
      })

      ;($content as any).setLiveStep = (step: string, label: string) => {
        if ($liveTracker) {
          $liveTracker.classList.remove('hidden')
        }
        if ($liveStepBadge) {
          const stepBadges: Record<string, string> = {
            tools: 'HERRAMIENTAS',
            planning: 'PLANIFICACIÓN',
            draft: 'BORRADOR',
            validation: 'VALIDACIÓN',
            refinement: 'REFINAMIENTO',
          }
          $liveStepBadge.textContent = stepBadges[step] || step.toUpperCase()
        }
        if ($liveStepLabel) {
          $liveStepLabel.textContent = label
        }
        if ($thoughtContent && currentStepKey !== step) {
          currentStepKey = step
          const headers: Record<string, string> = {
            planning: '#### 📋 Planificación de puntos clave\n\n',
            tools: '\n\n#### 🛠️ Herramientas y Validación Grounding\n\n',
            draft: '\n\n#### 📝 Borrador preliminar\n\n',
            validation: '\n\n#### 🔍 Validación y control de calidad\n\n',
            refinement: '\n\n#### ✨ Refinamiento final\n\n',
          }
          accumulatedThoughtMarkdown += headers[step] || `\n\n#### ${step.toUpperCase()}\n\n`
          thoughtStreamer?.push(accumulatedThoughtMarkdown)
        }
      }

      ;($content as any).appendLiveThought = (_step: string, delta: string, _accumulated: string) => {
        if (delta && thoughtStreamer) {
          accumulatedThoughtMarkdown += delta
          thoughtStreamer.push(accumulatedThoughtMarkdown)
        }
      }

      ;($content as any).finishReasoning = async (steps: ReasoningStep[]) => {
        if (thoughtStreamer && accumulatedThoughtMarkdown) {
          await thoughtStreamer.finish(accumulatedThoughtMarkdown)
        }
        if ($liveTracker) {
          $liveTracker.classList.add('opacity-0')
          setTimeout(() => {
            $liveTracker.classList.add('hidden')
            $liveTracker.classList.remove('opacity-0')
          }, 300)
        }
        if ($reasoningContainer && steps && steps.length > 0) {
          $reasoningContainer.innerHTML = renderReasoningAccordionHtml(steps)
          hydrateReasoningMarkdown($reasoningContainer)
        }
      }

      hydrateReasoningMarkdown(li)

      if (content) {
        renderMarkdown(content).then(rendered => {
          $content.innerHTML = rendered
        })
      }

      // Copy response handler
      const copyBtn = li.querySelector('.copy-btn') as HTMLButtonElement
      const copyText = li.querySelector('.copy-text') as HTMLSpanElement
      const copyIcon = li.querySelector('.copy-icon') as HTMLElement
      const checkIcon = li.querySelector('.check-icon') as HTMLElement

      copyBtn?.addEventListener('click', () => {
        const textToCopy = content || ($content.textContent ?? '')
        navigator.clipboard.writeText(textToCopy).then(() => {
          copyText.textContent = '¡Copiado!'
          copyIcon.classList.add('hidden')
          checkIcon.classList.remove('hidden')
          setTimeout(() => {
            copyText.textContent = 'Copiar'
            copyIcon.classList.remove('hidden')
            checkIcon.classList.add('hidden')
          }, 2000)
        })
      })

      $messageList.appendChild(li)
      return $content
    }
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div')
    div.textContent = text
    return div.innerHTML
  }

  // Delegated Code Block Copy Handling
  $messageList?.addEventListener('click', e => {
    const target = e.target as HTMLElement
    const copyBtn = target.closest('.copy-code-btn') as HTMLButtonElement | null
    if (!copyBtn) return

    const rawCode = copyBtn.dataset.code
    if (rawCode) {
      const code = decodeURIComponent(rawCode)
      navigator.clipboard.writeText(code).then(() => {
        const textSpan = copyBtn.querySelector('span')
        if (textSpan) {
          const original = textSpan.textContent
          textSpan.textContent = '¡Copiado!'
          setTimeout(() => {
            textSpan.textContent = original
          }, 2000)
        }
      })
    }
  })

  // Quick Starter Prompts in Empty State
  document.addEventListener('click', e => {
    const target = e.target as HTMLElement
    const btn = target.closest('.prompt-suggestion-btn') as HTMLButtonElement | null
    if (!btn) return

    const promptText = btn.dataset.prompt
    if (promptText && $input) {
      $input.value = promptText
      $input.style.height = 'auto'
      $input.style.height = `${Math.min($input.scrollHeight, 176)}px`
      updateSendButtonState()
      $form.requestSubmit()
    }
  })

  // Render Grouped Conversations List
  function renderConversationsList() {
    const conversations = loadConversations()
    $conversationsList.innerHTML = ''

    if (conversations.length === 0) {
      $noConversations?.classList.remove('hidden')
      return
    }

    $noConversations?.classList.add('hidden')

    const groups = groupConversationsByPeriod(conversations)

    groups.forEach(group => {
      // Group header
      const headerDiv = document.createElement('div')
      headerDiv.className = 'text-[11px] font-semibold text-[var(--text-muted)] px-3 pt-3 pb-1 tracking-wider uppercase select-none'
      headerDiv.textContent = group.label
      $conversationsList.appendChild(headerDiv)

      const ul = document.createElement('ul')
      ul.className = 'space-y-0.5'

      group.conversations.forEach(conv => {
        const isActive = currentConversation?.id === conv.id
        const li = document.createElement('li')
        li.dataset.id = conv.id
        li.className = `conversation-item group flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm cursor-pointer transition-colors select-none ${
          isActive
            ? 'bg-[var(--border-subtle)] font-medium text-[var(--text-primary)]'
            : 'hover:bg-[var(--border-subtle)]/60 text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
        }`

        li.innerHTML = `
          <span class="truncate flex-1 min-w-0" title="${conv.title}">${escapeHtml(conv.title)}</span>
          <button
            type="button"
            class="delete-conversation opacity-0 group-hover:opacity-100 p-1 text-[var(--text-muted)] hover:text-red-500 rounded transition-opacity"
            title="Eliminar conversación"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        `

        // Click on item loads conversation
        li.addEventListener('click', e => {
          if ((e.target as HTMLElement).closest('.delete-conversation')) return
          loadConversation(conv)
        })

        // Delete button
        const deleteBtn = li.querySelector('.delete-conversation')
        deleteBtn?.addEventListener('click', e => {
          e.stopPropagation()
          deleteConversation(conv.id)
          if (currentConversation?.id === conv.id) {
            startNewConversation()
          }
          renderConversationsList()
        })

        ul.appendChild(li)
      })

      $conversationsList.appendChild(ul)
    })
  }

  // Auto-resize Textarea & Update Send Button
  function updateSendButtonState() {
    if (!$sendBtn) return
    const text = $input ? $input.value.trim() : ''
    const generating = typeof isGenerating !== 'undefined' ? isGenerating : false

    if (generating) {
      $sendBtn.disabled = false
      $sendBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center transition-all duration-150 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 cursor-pointer shadow-xs hover:opacity-90 shrink-0'
      $sendBtn.title = 'Detener respuesta'
      $sendIcon?.classList.add('hidden')
      $stopIcon?.classList.remove('hidden')
    } else {
      $sendIcon?.classList.remove('hidden')
      $stopIcon?.classList.add('hidden')
      $sendBtn.title = 'Enviar mensaje'

      if ((text.length > 0 || hasAttachedDocuments()) && getCurrentModelId()) {
        $sendBtn.disabled = false
        $sendBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center transition-all duration-150 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 cursor-pointer shadow-xs hover:opacity-90 shrink-0'
      } else {
        $sendBtn.disabled = true
        $sendBtn.className = 'w-8 h-8 rounded-full flex items-center justify-center transition-all duration-150 bg-neutral-200 dark:bg-neutral-800 text-neutral-400 dark:text-neutral-500 cursor-not-allowed shrink-0'
      }
    }
  }

  if ($input) {
    $input.addEventListener('input', () => {
      $input.style.height = 'auto'
      $input.style.height = `${Math.min($input.scrollHeight, 176)}px`
      updateSendButtonState()
    })

    $input.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault()
        if (isGenerating) return
        if (($input.value.trim().length > 0 || hasAttachedDocuments()) && !$sendBtn.disabled) {
          $form.requestSubmit()
        }
      }
    })
  }

  // Send Button Click Handler (Handles Send and Interrupt)
  $sendBtn?.addEventListener('click', e => {
    if (isGenerating) {
      e.preventDefault()
      abortPipeline()
      stopGeneration()
      isGenerating = false
      updateSendButtonState()
      updateModelStatus('ready', 'Listo')
      $typingIndicator?.classList.add('hidden')
    }
  })

  // Form submission
  $form.addEventListener('submit', async e => {
    e.preventDefault()
    if (isGenerating) return
    if (!currentConversation) {
      updateModelStatus('error', 'Sin conversación')
      return
    }
    if (!getCurrentModelId()) {
      updateModelStatus('error', 'Modelo no cargado')
      return
    }

    let messageText = $input.value.trim()
    if (!messageText && hasAttachedDocuments()) {
      messageText = "Analiza y resume los datos clave del documento adjunto."
    }
    if (!messageText) return

    $input.value = ''
    $input.style.height = 'auto'
    updateSendButtonState()

    // Add user message
    const userMessage = addMessageToConversation(currentConversation!, 'user', messageText)
    chatMessages.push(userMessage)
    addMessageToDOM(messageText, 'user')
    scrollToBottom(true)

    // Update title if first message
    currentConversation = updateConversationTitle(currentConversation!)
    saveConversation(currentConversation!)
    renderConversationsList()

    // Start generation
    isGenerating = true
    updateSendButtonState()
    updateModelStatus('generating', 'Generando...')
    $typingIndicator.classList.remove('hidden')
    scrollToBottom(true)

    // Determine active skill for this message (Auto vs Specific Skill vs None)
    const currentSkillMode = getSkillMode()
    let effectiveSkill: Skill | null = null

    if (currentSkillMode === 'auto') {
      const match = matchSkillForPrompt(messageText)
      if (match) {
        effectiveSkill = match.skill
      }
    } else if (currentSkillMode !== 'none') {
      effectiveSkill = getSkillById(currentSkillMode) ?? null
    }

    const skillInfo = effectiveSkill
      ? { id: effectiveSkill.id, name: effectiveSkill.name, icon: effectiveSkill.icon }
      : undefined

    let streamer: ReturnType<typeof createStreamingRenderer> | null = null
    try {
      // Create placeholder for assistant message
      const $assistantContent = addMessageToDOM('', 'assistant', skillInfo) as HTMLElement & {
        setLiveStep?: (step: string, label: string) => void
        appendLiveThought?: (step: string, delta: string, accumulated: string) => void
        finishReasoning?: (steps: ReasoningStep[]) => void
      }
      $typingIndicator.classList.add('hidden')

      streamer = createStreamingRenderer(html => {
        $assistantContent.innerHTML = html
        if (!userScrolledUp) {
          scrollToBottom(false)
        }
      })

      const shouldUsePipeline = (getRefinementMode() && !isTrivialQuery(messageText)) || hasAttachedDocuments()
      let response = ''
      let reasoningSteps: ReasoningStep[] | undefined

      if (shouldUsePipeline) {
        const initialStep = hasAttachedDocuments() ? 'tools' : 'planning'
        const initialLabel = hasAttachedDocuments()
          ? 'Leyendo y analizando documentos adjuntos...'
          : 'Iniciando análisis y planificación...'
        $assistantContent.setLiveStep?.(initialStep, initialLabel)
        const pipelineResult = await runAgenticPipeline(
          messageText,
          chatMessages,
          {
            onStepChange: (step, label) => {
              $assistantContent.setLiveStep?.(step, label)
              if (!userScrolledUp) {
                scrollToBottom(false)
              }
            },
            onStepThought: (step, delta, accumulated) => {
              $assistantContent.appendLiveThought?.(step, delta, accumulated)
              if (!userScrolledUp) {
                scrollToBottom(false)
              }
            },
            onChunk: text => {
              streamer?.push(text)
            },
          },
          effectiveSkill
        )
        response = pipelineResult.finalResponse || pipelineResult.content || ''
        reasoningSteps = pipelineResult.reasoningSteps
        $assistantContent.finishReasoning?.(reasoningSteps)
      } else {
        response = await sendMessage(
          chatMessages,
          text => {
            streamer?.push(text)
          },
          effectiveSkill
        )
      }

      await streamer.finish(response)

      // Save assistant message with skill metadata and reasoning steps
      const assistantMessage = addMessageToConversation(
        currentConversation!,
        'assistant',
        response,
        skillInfo,
        reasoningSteps
      )
      chatMessages.push(assistantMessage)
      saveConversation(currentConversation!)
    } catch (error) {
      streamer?.reset()
      console.error('Error sending message:', error)
      $typingIndicator.classList.add('hidden')

      // Show error message
      const errorMessage = addMessageToConversation(
        currentConversation!,
        'assistant',
        'Lo siento, ocurrió un error al procesar el mensaje con el modelo local. Intenta nuevamente.',
        skillInfo
      )
      chatMessages.push(errorMessage)
      addMessageToDOM(errorMessage.content, 'assistant', skillInfo)
      saveConversation(currentConversation!)
    } finally {
      isGenerating = false
      updateSendButtonState()
      updateModelStatus('ready', 'Listo')
      if (!userScrolledUp) {
        scrollToBottom(true)
      }
    }
  })

  // Custom Model Selector UI & Behavior
  function updateModelUI(modelId: string) {
    const model = getModelById(modelId)
    if (!model) return
    if ($currentModelName) $currentModelName.textContent = model.name
    if ($currentModelSize) $currentModelSize.textContent = `(${model.size})`
    if ($modelSelect) $modelSelect.value = modelId

    modelOptionBtns.forEach(btn => {
      const isSelected = btn.dataset.modelId === modelId
      const checkIcon = btn.querySelector('.model-check-icon')
      if (isSelected) {
        btn.classList.add('bg-[var(--bg-secondary)]')
        checkIcon?.classList.remove('opacity-0')
        btn.setAttribute('aria-selected', 'true')
      } else {
        btn.classList.remove('bg-[var(--bg-secondary)]')
        checkIcon?.classList.add('opacity-0')
        btn.setAttribute('aria-selected', 'false')
      }
    })
  }

  function toggleModelPopover(show?: boolean) {
    if (!$modelPopoverMenu) return
    const isHidden = $modelPopoverMenu.classList.contains('hidden')
    const shouldOpen = show !== undefined ? show : isHidden

    if (shouldOpen) {
      $modelPopoverMenu.classList.remove('hidden')
      $modelChevron?.classList.add('rotate-180')
      $modelPopoverTrigger?.setAttribute('aria-expanded', 'true')
    } else {
      $modelPopoverMenu.classList.add('hidden')
      $modelChevron?.classList.remove('rotate-180')
      $modelPopoverTrigger?.setAttribute('aria-expanded', 'false')
    }
  }

  async function handleModelChange(newModelId: string) {
    toggleModelPopover(false)
    if (newModelId === getCurrentModelId()) return

    setSelectedModel(newModelId)
    updateModelUI(newModelId)

    const isCached = await checkIfModelIsCached(newModelId)
    const modelConfig = getModelById(newModelId)
    if (modelConfig && $loadingModelName) {
      $loadingModelName.textContent = isCached
        ? `${modelConfig.name} (en caché local)`
        : `${modelConfig.name} (${modelConfig.size})`
    }

    showLoadingOverlay()
    updateModelStatus('loading', 'Cambiando...')
    if ($sendBtn) $sendBtn.disabled = true

    try {
      await switchModel(newModelId, onProgress)
      hideLoadingOverlay()
      updateModelStatus('ready', 'Listo')
      updateSendButtonState()
    } catch (error) {
      console.error('Error switching model:', error)
      hideLoadingOverlay()
      updateModelStatus('error', 'Error al cambiar')
      updateSendButtonState()
    }
  }

  $modelPopoverTrigger?.addEventListener('click', (e) => {
    e.stopPropagation()
    toggleModelPopover()
  })

  modelOptionBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      const modelId = btn.dataset.modelId
      if (modelId) handleModelChange(modelId)
    })
  })

  document.addEventListener('click', (e) => {
    if (!$modelPopoverMenu?.contains(e.target as Node) && !$modelPopoverTrigger?.contains(e.target as Node)) {
      toggleModelPopover(false)
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggleModelPopover(false)
    }
  })

  // Hidden Select elements fallback
  $modelSelect?.addEventListener('change', () => {
    if ($modelSelect && $modelSelect.value) handleModelChange($modelSelect.value)
  })

  // New chat buttons
  $newChatBtn.addEventListener('click', startNewConversation)
  $newChatSidebar.addEventListener('click', startNewConversation)

  // ==========================================
  // Skills System & Marketplace Management
  // ==========================================
  let currentPreviewItem: Skill | SkillCatalogItem | any | null = null
  let activeMarketplaceCategory = 'all'
  let currentLeaderboardView = 'trending'
  let liveMarketplaceSkills: any[] = []
  let hasFetchedMarketplaceOnce = false
  let searchDebounceTimeout: any = null

  function initSkills() {
    updateSkillUI()
    renderMarketplaceCards()
    renderInstalledSkillsList()
    setupSkillsListeners()
  }

  function updateSkillUI() {
    const mode = getSkillMode()
    const installed = getInstalledSkills()
    const active = getActiveSkills()

    // 1. Update trigger button
    if (mode === 'auto') {
      if ($currentSkillLabel) $currentSkillLabel.textContent = 'Skill: Auto'
      if ($skillPillIcon) $skillPillIcon.textContent = '✨'
    } else if (mode === 'none') {
      if ($currentSkillLabel) $currentSkillLabel.textContent = 'Skill: Ninguna'
      if ($skillPillIcon) $skillPillIcon.textContent = '○'
    } else {
      const skill = getSkillById(mode)
      if (skill) {
        if ($currentSkillLabel) $currentSkillLabel.textContent = skill.name
        if ($skillPillIcon) $skillPillIcon.textContent = skill.icon || '⚡'
      } else {
        setSkillMode('auto')
        if ($currentSkillLabel) $currentSkillLabel.textContent = 'Skill: Auto'
        if ($skillPillIcon) $skillPillIcon.textContent = '✨'
      }
    }

    // 2. Update badges & counts
    if ($skillActiveBadge) $skillActiveBadge.textContent = `${active.length} activas`
    if ($sidebarSkillsCount) $sidebarSkillsCount.textContent = `${active.length} activas`
    if ($tabInstalledCount) $tabInstalledCount.textContent = `${installed.length}`

    // 3. Update popover mode checkmarks
    skillModeBtns.forEach(btn => {
      const btnMode = btn.dataset.mode
      const checkIcon = btn.querySelector('.skill-check-icon')
      if (btnMode === mode) {
        btn.classList.add('bg-[var(--bg-secondary)]')
        checkIcon?.classList.remove('opacity-0')
      } else {
        btn.classList.remove('bg-[var(--bg-secondary)]')
        checkIcon?.classList.add('opacity-0')
      }
    })

    // 4. Render quick list of skills in popover
    if ($quickSkillsList) {
      $quickSkillsList.innerHTML = ''
      if (installed.length === 0) {
        const empty = document.createElement('div')
        empty.className = 'px-2.5 py-1.5 text-[11px] text-[var(--text-muted)] italic'
        empty.textContent = 'Sin skills instaladas'
        $quickSkillsList.appendChild(empty)
      } else {
        installed.forEach(skill => {
          const isSelected = mode === skill.id
          const btn = document.createElement('button')
          btn.type = 'button'
          btn.className = `w-full text-left p-1.5 px-2 rounded-lg text-xs flex items-center justify-between gap-1.5 cursor-pointer transition-colors ${
            isSelected
              ? 'bg-[var(--bg-secondary)] font-medium text-[var(--text-primary)]'
              : 'hover:bg-[var(--bg-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
          }`

          btn.innerHTML = `
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="text-xs shrink-0">${skill.icon || '⚡'}</span>
              <span class="truncate">${escapeHtml(skill.name)}</span>
              ${!skill.enabled ? '<span class="text-[9px] px-1 py-0.2 rounded bg-neutral-200 dark:bg-neutral-800 text-[var(--text-muted)]">inactiva</span>' : ''}
            </div>
            ${isSelected ? '<svg class="w-3.5 h-3.5 text-indigo-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>' : ''}
          `

          btn.addEventListener('click', (e) => {
            e.stopPropagation()
            setSkillMode(skill.id)
            updateSkillUI()
            toggleSkillPopover(false)
          })

          $quickSkillsList.appendChild(btn)
        })
      }
    }
  }

  function toggleSkillPopover(show?: boolean) {
    if (!$skillPopoverMenu) return
    const isHidden = $skillPopoverMenu.classList.contains('hidden')
    const shouldOpen = show !== undefined ? show : isHidden

    if (shouldOpen) {
      toggleModelPopover(false)
      $skillPopoverMenu.classList.remove('hidden')
      $skillChevron?.classList.add('rotate-180')
      $skillPopoverTrigger?.setAttribute('aria-expanded', 'true')
    } else {
      $skillPopoverMenu.classList.add('hidden')
      $skillChevron?.classList.remove('rotate-180')
      $skillPopoverTrigger?.setAttribute('aria-expanded', 'false')
    }
  }

  function openSkillsModal(defaultTab: 'marketplace' | 'installed' | 'import' = 'marketplace') {
    toggleSkillPopover(false)
    toggleModelPopover(false)
    if ($skillsModal) {
      $skillsModal.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
      switchSkillsTab(defaultTab)
      if (defaultTab === 'marketplace') {
        if (!hasFetchedMarketplaceOnce) {
          hasFetchedMarketplaceOnce = true
          fetchLiveLeaderboard('trending')
        } else {
          renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
        }
      }
      renderInstalledSkillsList()
      if (defaultTab === 'marketplace' && $marketplaceSearchInput) {
        setTimeout(() => $marketplaceSearchInput.focus(), 50)
      }
    }
  }

  function closeSkillsModal() {
    if ($skillsModal) {
      $skillsModal.classList.add('hidden')
      document.body.style.overflow = ''
    }
    closeSkillPreview()
  }

  function switchSkillsTab(tabName: 'marketplace' | 'installed' | 'import') {
    skillsTabBtns.forEach(btn => {
      const isTarget = btn.dataset.tab === tabName
      if (isTarget) {
        btn.classList.add('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold')
        btn.classList.remove('border-transparent', 'text-[var(--text-secondary)]')
      } else {
        btn.classList.remove('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold')
        btn.classList.add('border-transparent', 'text-[var(--text-secondary)]')
      }
    })

    $tabPanelMarketplace?.classList.toggle('hidden', tabName !== 'marketplace')
    $tabPanelInstalled?.classList.toggle('hidden', tabName !== 'installed')
    $tabPanelImport?.classList.toggle('hidden', tabName !== 'import')

    if (tabName === 'installed') {
      renderInstalledSkillsList()
    } else if (tabName === 'marketplace') {
      renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
    }
  }

  function showMarketplaceLoading(loading: boolean) {
    if ($marketplaceLoadingState) {
      $marketplaceLoadingState.classList.toggle('hidden', !loading)
    }
    if ($marketplaceCardsGrid) {
      $marketplaceCardsGrid.classList.toggle('opacity-40', loading)
    }
  }

  function updateLiveStatus(live: boolean, text: string) {
    if ($liveApiDot) {
      if (live) {
        $liveApiDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse'
      } else {
        $liveApiDot.className = 'w-2 h-2 rounded-full bg-amber-500'
      }
    }
    if ($liveApiStatusText) {
      $liveApiStatusText.textContent = text
    }
  }

  async function fetchLiveLeaderboard(view = 'trending') {
    currentLeaderboardView = view
    leaderboardViewBtns.forEach(btn => {
      if (btn.dataset.view === view) {
        btn.className = 'leaderboard-view-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 cursor-pointer shadow-2xs'
      } else {
        btn.className = 'leaderboard-view-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--bg-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] cursor-pointer'
      }
    })

    showMarketplaceLoading(true)

    try {
      const res = await fetch(`/api/skills?view=${encodeURIComponent(view)}&per_page=30`)
      const data = await res.json()

      if (data.success && data.skills && data.skills.length > 0) {
        updateLiveStatus(true, `En vivo (${data.skills.length})`)
        liveMarketplaceSkills = data.skills
      } else {
        updateLiveStatus(false, 'Catálogo precargado')
        liveMarketplaceSkills = []
      }
    } catch (err) {
      console.warn('Live skills fetch fallback:', err)
      updateLiveStatus(false, 'Catálogo precargado')
      liveMarketplaceSkills = []
    } finally {
      showMarketplaceLoading(false)
      renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
    }
  }

  async function searchSkillsLive(query: string) {
    const q = query.trim()
    if (!q) {
      fetchLiveLeaderboard(currentLeaderboardView)
      return
    }

    showMarketplaceLoading(true)

    try {
      const res = await fetch(`/api/skills/search?q=${encodeURIComponent(q)}&limit=30`)
      const data = await res.json()

      if (data.success && data.skills && data.skills.length > 0) {
        updateLiveStatus(true, `Resultados (${data.skills.length})`)
        liveMarketplaceSkills = data.skills
      } else {
        updateLiveStatus(false, 'Catálogo precargado')
        liveMarketplaceSkills = []
      }
    } catch (err) {
      console.warn('Search skills live fallback:', err)
      updateLiveStatus(false, 'Catálogo precargado')
      liveMarketplaceSkills = []
    } finally {
      showMarketplaceLoading(false)
      renderMarketplaceCards(activeMarketplaceCategory, q)
    }
  }

  async function handleImportSkill(item: any, installBtn: HTMLButtonElement) {
    if (isSkillInstalled(item.id)) {
      switchSkillsTab('installed')
      return
    }

    if (item.systemPrompt && SKILLS_CATALOG.some(c => c.id === item.id)) {
      installFromCatalog(item.id)
      installBtn.textContent = '✓ Instalada'
      installBtn.className = 'install-skill-btn px-3 py-1.2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-neutral-200 dark:bg-neutral-800 text-[var(--text-secondary)] hover:bg-neutral-300 dark:hover:bg-neutral-700'
      installBtn.dataset.installed = 'true'
      updateSkillUI()
      renderInstalledSkillsList()
      return
    }

    installBtn.disabled = true
    installBtn.textContent = 'Descargando...'

    try {
      const res = await fetch(`/api/skills/detail?id=${encodeURIComponent(item.id)}`)
      const data = await res.json()
      if (!data.success || !data.skillMarkdown) {
        throw new Error(data.message || 'No se pudo obtener el archivo SKILL.md')
      }

      const parsed = parseSkillMarkdown(data.skillMarkdown, item.name || 'Skill')
      const newSkill: Skill = {
        id: item.id,
        name: parsed.name || item.name,
        description: parsed.description || item.description || 'Skill importada desde skills.sh',
        systemPrompt: parsed.systemPrompt,
        tags: parsed.tags.length > 0 ? parsed.tags : (item.tags || ['skills.sh']),
        author: data.source || item.source || 'skills.sh',
        repo: data.source || item.source || item.id,
        icon: item.icon || '📦',
        source: 'marketplace',
        installedAt: Date.now(),
        enabled: true,
        triggers: parsed.triggers,
        stats: {
          installs: typeof item.installs === 'number' ? item.installs.toLocaleString() : (item.installs || 'Popular'),
          activity: 'skills.sh',
        },
      }

      saveSkill(newSkill)
      installBtn.textContent = '✓ Instalada'
      installBtn.className = 'install-skill-btn px-3 py-1.2 rounded-xl text-xs font-medium transition-all cursor-pointer bg-neutral-200 dark:bg-neutral-800 text-[var(--text-secondary)] hover:bg-neutral-300 dark:hover:bg-neutral-700'
      installBtn.dataset.installed = 'true'
      updateSkillUI()
      renderInstalledSkillsList()
    } catch (err: any) {
      alert(`Error al importar: ${err.message || 'No se pudo descargar la skill'}`)
      installBtn.textContent = '+ Importar'
    } finally {
      installBtn.disabled = false
    }
  }

  function renderMarketplaceCards(category = 'all', query = '') {
    if (!$marketplaceCardsGrid) return
    $marketplaceCardsGrid.innerHTML = ''
    const q = query.toLowerCase().trim()

    const sourceList = liveMarketplaceSkills.length > 0 ? liveMarketplaceSkills : SKILLS_CATALOG

    const filtered = sourceList.filter(item => {
      const tags: string[] = item.tags || []
      const matchesCategory = category === 'all' || tags.some(t => t.toLowerCase() === category.toLowerCase())
      const name = (item.name || '').toLowerCase()
      const desc = (item.description || '').toLowerCase()
      const author = (item.author || item.source || '').toLowerCase()
      const repo = (item.repo || item.id || '').toLowerCase()

      const matchesQuery = !q ||
        name.includes(q) ||
        desc.includes(q) ||
        author.includes(q) ||
        repo.includes(q) ||
        tags.some(t => t.toLowerCase().includes(q))
      return matchesCategory && matchesQuery
    })

    if (filtered.length === 0) {
      $marketplaceEmptyResults?.classList.remove('hidden')
      return
    }

    $marketplaceEmptyResults?.classList.add('hidden')

    filtered.forEach(item => {
      const installed = isSkillInstalled(item.id)
      const icon = item.icon || '📦'
      const name = item.name || item.id.split('/').pop() || 'Skill'
      const repo = item.repo || item.source || item.id
      const desc = item.description || 'Skill de la comunidad para agentes IA.'
      const tags: string[] = item.tags || ['skills.sh']
      const installsDisplay = typeof item.installs === 'number'
        ? item.installs.toLocaleString()
        : (item.stats?.installs || item.installs || 'Popular')

      const card = document.createElement('div')
      card.className = 'p-3.5 sm:p-4 rounded-2xl bg-[var(--bg-secondary)] border border-[var(--border-subtle)] hover:border-indigo-500/40 transition-all flex flex-col justify-between gap-3 group shadow-2xs'

      card.innerHTML = `
        <div class="space-y-2">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="text-xl p-2 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-subtle)] shadow-2xs">${icon}</span>
              <div class="min-w-0">
                <h3 class="font-semibold text-xs sm:text-sm text-[var(--text-primary)] group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">${escapeHtml(name)}</h3>
                <p class="text-[10px] text-[var(--text-muted)] font-mono truncate">${escapeHtml(repo)}</p>
              </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-[var(--bg-primary)] border border-[var(--border-subtle)] font-mono text-[var(--text-secondary)]">
                ${installsDisplay}
              </span>
            </div>
          </div>

          <p class="text-xs text-[var(--text-secondary)] line-clamp-2 leading-relaxed">
            ${escapeHtml(desc)}
          </p>

          <div class="flex flex-wrap gap-1 pt-1">
            ${tags.map(tag => `<span class="text-[9px] px-1.5 py-0.2 rounded-md bg-[var(--bg-primary)] border border-[var(--border-subtle)] text-[var(--text-muted)] font-medium">${escapeHtml(tag)}</span>`).join('')}
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-[var(--border-subtle)]/70">
          <button
            type="button"
            class="view-skill-btn text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer py-1"
          >
            Ver SKILL.md
          </button>
          
          <button
            type="button"
            class="install-skill-btn px-3 py-1.2 rounded-xl text-xs font-medium transition-all cursor-pointer ${
              installed
                ? 'bg-neutral-200 dark:bg-neutral-800 text-[var(--text-secondary)] hover:bg-neutral-300 dark:hover:bg-neutral-700'
                : 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs'
            }"
            data-installed="${installed ? 'true' : 'false'}"
          >
            ${installed ? '✓ Instalada' : '+ Importar'}
          </button>
        </div>
      `

      card.querySelector('.view-skill-btn')?.addEventListener('click', () => {
        openSkillPreview(item)
      })

      const installBtn = card.querySelector('.install-skill-btn') as HTMLButtonElement
      installBtn?.addEventListener('click', () => {
        handleImportSkill(item, installBtn)
      })

      $marketplaceCardsGrid.appendChild(card)
    })
  }

  function renderInstalledSkillsList() {
    if (!$installedSkillsList) return
    $installedSkillsList.innerHTML = ''
    const installed = getInstalledSkills()
    const currentMode = getSkillMode()

    if (installed.length === 0) {
      $installedEmptyState?.classList.remove('hidden')
      return
    }

    $installedEmptyState?.classList.add('hidden')

    installed.forEach(skill => {
      const isCurrentActive = currentMode === skill.id
      const row = document.createElement('div')
      row.className = `p-3.5 sm:p-4 rounded-2xl border transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-2xs ${
        skill.enabled
          ? 'bg-[var(--bg-secondary)] border-[var(--border-subtle)]'
          : 'bg-[var(--bg-secondary)]/50 border-[var(--border-subtle)]/50 opacity-70'
      }`

      row.innerHTML = `
        <div class="flex items-start gap-3 min-w-0 flex-1">
          <span class="text-xl p-2 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-subtle)] shrink-0">${skill.icon || '⚡'}</span>
          <div class="min-w-0 space-y-1 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h4 class="font-semibold text-xs sm:text-sm text-[var(--text-primary)] truncate">${escapeHtml(skill.name)}</h4>
              ${isCurrentActive ? '<span class="text-[9px] font-medium px-2 py-0.2 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">Fijada en Chat</span>' : ''}
              <span class="text-[9px] px-1.5 py-0.2 rounded font-mono bg-[var(--bg-primary)] border border-[var(--border-subtle)] text-[var(--text-muted)]">${escapeHtml(skill.source)}</span>
            </div>
            <p class="text-xs text-[var(--text-secondary)] line-clamp-1 leading-snug">${escapeHtml(skill.description)}</p>
            <div class="flex flex-wrap gap-1 pt-0.5">
              ${skill.tags.map(t => `<span class="text-[9px] px-1.5 py-0.2 rounded bg-[var(--bg-primary)] text-[var(--text-muted)]">${escapeHtml(t)}</span>`).join('')}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2.5 self-end sm:self-center shrink-0">
          <!-- Activation Toggle Switch -->
          <label class="flex items-center gap-1.5 cursor-pointer select-none" title="${skill.enabled ? 'Desactivar skill' : 'Activar skill'}">
            <span class="text-[11px] text-[var(--text-muted)] hidden md:inline">${skill.enabled ? 'Activa' : 'Inactiva'}</span>
            <div class="relative">
              <input type="checkbox" class="sr-only toggle-skill-active" data-skill-id="${skill.id}" ${skill.enabled ? 'checked' : ''} />
              <div class="w-8 h-4.5 rounded-full transition-colors ${skill.enabled ? 'bg-indigo-600' : 'bg-neutral-300 dark:bg-neutral-700'}"></div>
              <div class="absolute left-0.5 top-0.5 w-3.5 h-3.5 rounded-full bg-white transition-transform ${skill.enabled ? 'translate-x-3.5' : ''}"></div>
            </div>
          </label>

          <!-- Pin to Chat Button -->
          <button
            type="button"
            class="pin-skill-btn px-2.5 py-1 rounded-lg text-xs font-medium border border-[var(--border-subtle)] hover:bg-[var(--bg-primary)] text-[var(--text-primary)] transition-colors cursor-pointer"
            title="Usar esta skill en el chat actual"
          >
            ${isCurrentActive ? 'En uso' : 'Fijar'}
          </button>

          <!-- View SKILL.md Prompt -->
          <button
            type="button"
            class="view-installed-btn p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--border-subtle)] transition-colors cursor-pointer"
            title="Ver directrices procedimentales"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </button>

          <!-- Delete Button -->
          <button
            type="button"
            class="delete-skill-btn p-1.5 rounded-lg text-[var(--text-muted)] hover:text-red-500 hover:bg-red-500/10 transition-colors cursor-pointer"
            title="Desinstalar skill"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      `

      // Toggle Active Switch
      row.querySelector('.toggle-skill-active')?.addEventListener('change', () => {
        toggleSkillEnabled(skill.id)
        updateSkillUI()
        renderInstalledSkillsList()
      })

      // Pin button
      row.querySelector('.pin-skill-btn')?.addEventListener('click', () => {
        setSkillMode(skill.id)
        updateSkillUI()
        closeSkillsModal()
      })

      // View button
      row.querySelector('.view-installed-btn')?.addEventListener('click', () => {
        openSkillPreview(skill)
      })

      // Delete button
      row.querySelector('.delete-skill-btn')?.addEventListener('click', () => {
        if (confirm(`¿Deseas desinstalar la skill "${skill.name}"?`)) {
          deleteSkill(skill.id)
          updateSkillUI()
          renderInstalledSkillsList()
          renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
        }
      })

      $installedSkillsList.appendChild(row)
    })
  }

  async function openSkillPreview(item: Skill | SkillCatalogItem | any) {
    currentPreviewItem = item
    if (!$skillPreviewModal) return

    const name = item.name || item.id.split('/').pop() || 'Skill'
    const repo = item.repo || item.source || item.id || 'Local'
    const icon = item.icon || '⚡'
    const desc = item.description || 'Skill de la comunidad para agentes IA.'

    if ($previewSkillTitle) $previewSkillTitle.textContent = name
    if ($previewSkillRepo) $previewSkillRepo.textContent = repo
    if ($previewSkillIcon) $previewSkillIcon.textContent = icon
    if ($previewSkillDesc) $previewSkillDesc.textContent = desc

    const installed = isSkillInstalled(item.id)
    if ($previewActionBtn) {
      $previewActionBtn.textContent = installed ? 'Fijar en Chat' : '+ Importar Skill'
      $previewActionBtn.className = installed
        ? 'px-4 py-1.5 text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 rounded-lg cursor-pointer'
        : 'px-4 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg cursor-pointer'
    }

    if (item.systemPrompt) {
      if ($previewSkillPrompt) $previewSkillPrompt.textContent = item.systemPrompt
    } else {
      if ($previewSkillPrompt) $previewSkillPrompt.textContent = 'Cargando directrices procedimentales (SKILL.md) desde el servidor...'
      try {
        const res = await fetch(`/api/skills/detail?id=${encodeURIComponent(item.id)}`)
        const data = await res.json()
        if (data.success && data.skillMarkdown) {
          item.systemPrompt = data.skillMarkdown
          if ($previewSkillPrompt && currentPreviewItem?.id === item.id) {
            $previewSkillPrompt.textContent = data.skillMarkdown
          }
        } else {
          if ($previewSkillPrompt && currentPreviewItem?.id === item.id) {
            $previewSkillPrompt.textContent = `No se pudieron cargar las directrices de SKILL.md.\n${data.message || ''}`
          }
        }
      } catch (err: any) {
        if ($previewSkillPrompt && currentPreviewItem?.id === item.id) {
          $previewSkillPrompt.textContent = 'Error al consultar SKILL.md en el servidor.'
        }
      }
    }

    $skillPreviewModal.classList.remove('hidden')
  }

  function closeSkillPreview() {
    currentPreviewItem = null
    $skillPreviewModal?.classList.add('hidden')
  }

  function setupSkillsListeners() {
    // Popover trigger
    $skillPopoverTrigger?.addEventListener('click', (e) => {
      e.stopPropagation()
      toggleSkillPopover()
    })

    // Mode buttons in popover (auto vs none)
    skillModeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation()
        const mode = btn.dataset.mode as SkillMode
        if (mode) {
          setSkillMode(mode)
          updateSkillUI()
          toggleSkillPopover(false)
        }
      })
    })

    // Open modal from popover footer
    $openMarketplaceFromPopover?.addEventListener('click', (e) => {
      e.stopPropagation()
      openSkillsModal('marketplace')
    })

    // Open modal from sidebar button
    $openSkillsMarketplaceBtn?.addEventListener('click', () => {
      openSkillsModal('marketplace')
    })

    // Close modal button
    $closeSkillsModal?.addEventListener('click', closeSkillsModal)

    // Backdrop click to close modal
    $skillsModal?.addEventListener('click', (e) => {
      if (e.target === $skillsModal) {
        closeSkillsModal()
      }
    })

    // Modal Tabs
    skillsTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab as 'marketplace' | 'installed' | 'import'
        if (tab) switchSkillsTab(tab)
      })
    })

    // Leaderboard view pills (Trending, All-Time, Hot)
    leaderboardViewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view || 'trending'
        fetchLiveLeaderboard(view)
      })
    })

    // Marketplace Search (debounced for live search)
    $marketplaceSearchInput?.addEventListener('input', () => {
      const val = $marketplaceSearchInput.value
      clearTimeout(searchDebounceTimeout)
      searchDebounceTimeout = setTimeout(() => {
        if (val.trim()) {
          searchSkillsLive(val)
        } else {
          fetchLiveLeaderboard(currentLeaderboardView)
        }
      }, 350)
    })

    // Category filter pills
    categoryFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category || 'all'
        activeMarketplaceCategory = category

        categoryFilterBtns.forEach(b => {
          if (b.dataset.category === category) {
            b.className = 'category-filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 cursor-pointer'
          } else {
            b.className = 'category-filter-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--bg-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] cursor-pointer'
          }
        })

        renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
      })
    })

    // GitHub import form
    $githubImportForm?.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!$githubRepoInput || !$githubImportBtn || !$githubImportStatus) return

      const repo = $githubRepoInput.value.trim()
      if (!repo) return

      $githubImportBtn.disabled = true
      $githubImportBtn.textContent = 'Descargando...'
      $githubImportStatus.className = 'text-xs text-indigo-500'
      $githubImportStatus.textContent = 'Buscando SKILL.md en GitHub...'
      $githubImportStatus.classList.remove('hidden')

      try {
        const imported = await importSkillFromGitHub(repo)
        $githubImportStatus.className = 'text-xs text-emerald-500'
        $githubImportStatus.textContent = `¡Skill "${imported.name}" importada exitosamente!`
        $githubRepoInput.value = ''
        updateSkillUI()
        renderInstalledSkillsList()
        renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
        setTimeout(() => {
          switchSkillsTab('installed')
          $githubImportStatus?.classList.add('hidden')
        }, 1200)
      } catch (err: any) {
        $githubImportStatus.className = 'text-xs text-red-500'
        $githubImportStatus.textContent = err?.message || 'Error al importar repositorio.'
      } finally {
        $githubImportBtn.disabled = false
        $githubImportBtn.textContent = 'Descargar e Importar'
      }
    })

    // Custom skill form
    $customSkillForm?.addEventListener('submit', (e) => {
      e.preventDefault()
      if (!$customSkillName || !$customSkillDesc || !$customSkillPrompt) return

      const name = $customSkillName.value.trim()
      const desc = $customSkillDesc.value.trim()
      const prompt = $customSkillPrompt.value.trim()
      const tags = $customSkillTags?.value.split(',').map(t => t.trim()).filter(Boolean) || ['Custom']
      const triggers = $customSkillTriggers?.value.split(',').map(t => t.trim()).filter(Boolean) || [name.toLowerCase()]

      if (!name || !desc || !prompt) return

      const newSkill: Skill = {
        id: `custom_${Date.now()}`,
        name,
        description: desc,
        systemPrompt: prompt,
        tags,
        triggers,
        author: 'Tú',
        source: 'custom',
        installedAt: Date.now(),
        enabled: true,
        icon: '💡',
      }

      saveSkill(newSkill)
      $customSkillForm.reset()
      updateSkillUI()
      renderInstalledSkillsList()
      switchSkillsTab('installed')
    })

    // Preview modal actions
    $closeSkillPreview?.addEventListener('click', closeSkillPreview)
    $skillPreviewModal?.addEventListener('click', (e) => {
      if (e.target === $skillPreviewModal) closeSkillPreview()
    })

    $previewCopyBtn?.addEventListener('click', () => {
      if (currentPreviewItem && $previewCopyBtn) {
        navigator.clipboard.writeText(currentPreviewItem.systemPrompt || '')
        const prevText = $previewCopyBtn.textContent
        $previewCopyBtn.textContent = '¡Copiado!'
        setTimeout(() => {
          $previewCopyBtn.textContent = prevText
        }, 2000)
      }
    })

    $previewActionBtn?.addEventListener('click', async () => {
      if (!currentPreviewItem) return
      if (isSkillInstalled(currentPreviewItem.id)) {
        setSkillMode(currentPreviewItem.id)
        updateSkillUI()
        closeSkillsModal()
      } else {
        if (currentPreviewItem.systemPrompt && SKILLS_CATALOG.some(c => c.id === currentPreviewItem.id)) {
          installFromCatalog(currentPreviewItem.id)
        } else {
          try {
            $previewActionBtn.textContent = 'Importando...'
            const res = await fetch(`/api/skills/detail?id=${encodeURIComponent(currentPreviewItem.id)}`)
            const data = await res.json()
            if (data.success && data.skillMarkdown) {
              const parsed = parseSkillMarkdown(data.skillMarkdown, currentPreviewItem.name || 'Skill')
              const newSkill: Skill = {
                id: currentPreviewItem.id,
                name: parsed.name || currentPreviewItem.name,
                description: parsed.description || currentPreviewItem.description || 'Skill importada desde skills.sh',
                systemPrompt: parsed.systemPrompt,
                tags: parsed.tags.length > 0 ? parsed.tags : (currentPreviewItem.tags || ['skills.sh']),
                author: data.source || currentPreviewItem.source || 'skills.sh',
                repo: data.source || currentPreviewItem.source || currentPreviewItem.id,
                icon: currentPreviewItem.icon || '📦',
                source: 'marketplace',
                installedAt: Date.now(),
                enabled: true,
                triggers: parsed.triggers,
                stats: {
                  installs: typeof currentPreviewItem.installs === 'number' ? currentPreviewItem.installs.toLocaleString() : (currentPreviewItem.installs || 'Popular'),
                  activity: 'skills.sh',
                },
              }
              saveSkill(newSkill)
            }
          } catch (err) {
            console.error('Failed to import skill:', err)
          }
        }
        updateSkillUI()
        renderInstalledSkillsList()
        renderMarketplaceCards(activeMarketplaceCategory, $marketplaceSearchInput?.value || '')
        if ($previewActionBtn) {
          $previewActionBtn.textContent = 'Fijar en Chat'
          $previewActionBtn.className = 'px-4 py-1.5 text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 rounded-lg cursor-pointer'
        }
      }
    })

    // Global click listener to close popover
    document.addEventListener('click', (e) => {
      if (!$skillPopoverMenu?.contains(e.target as Node) && !$skillPopoverTrigger?.contains(e.target as Node)) {
        toggleSkillPopover(false)
      }
    })

    // Keyboard shortcut '/' to search skills when modal is open
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleSkillPopover(false)
        if ($skillPreviewModal && !$skillPreviewModal.classList.contains('hidden')) {
          closeSkillPreview()
        } else if ($skillsModal && !$skillsModal.classList.contains('hidden')) {
          closeSkillsModal()
        }
      } else if (e.key === '/' && $skillsModal && !$skillsModal.classList.contains('hidden')) {
        const activeEl = document.activeElement
        if (activeEl?.tagName !== 'INPUT' && activeEl?.tagName !== 'TEXTAREA') {
          e.preventDefault()
          $marketplaceSearchInput?.focus()
        }
      }
    })
  }

  // Start initialization
  init()
</script>
