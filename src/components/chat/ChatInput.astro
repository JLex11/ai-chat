---
import { AVAILABLE_MODELS } from '../../scripts/config/models'
import SkillPopover from '../skills/SkillPopover.astro'

const showPopoverPreview = Astro.url.searchParams.get('popover') === '1'
---

<div class="composer-container w-full px-4 pb-4 pt-8 bg-gradient-to-t from-[var(--bg-primary)] via-[var(--bg-primary)]/85 to-transparent transition-all duration-300">
  <div class="max-w-3xl mx-auto w-full relative">
    <!-- Scroll to bottom button -->
    <button
      id="scroll-bottom-btn"
      type="button"
      class="hidden absolute -top-11 left-1/2 -translate-x-1/2 p-2 bg-[var(--bg-secondary)]/90 dark:bg-[var(--bg-secondary)]/90 hover:bg-[var(--border-subtle)] border border-[var(--border-subtle)] rounded-full shadow-md backdrop-blur-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer z-10"
      title="Desplazar al final"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </button>

    <!-- Composer form -->
    <form id="chat-form" class="relative">
      <!-- Hidden input for model compatibility -->
      <input type="hidden" id="model-select" name="model" value={AVAILABLE_MODELS[0].id} />

      <div class="bg-[var(--bg-secondary)]/85 dark:bg-[var(--bg-secondary)]/85 backdrop-blur-xl border border-[var(--border-subtle)]/80 rounded-[26px] p-2 sm:p-2.5 shadow-lg hover:shadow-xl focus-within:border-[var(--text-muted)] focus-within:shadow-xl transition-all duration-200 flex flex-col gap-1.5">
        
        <!-- Attached Files Chips Container -->
        <div id="attached-files-container" class="hidden flex-wrap items-center gap-1.5 px-2 pt-1 pb-0.5"></div>

        <!-- Textarea -->
        <textarea
          id="message-input"
          name="message"
          placeholder="Pregunta a AI Chat... (prueba cálculos matemáticos, fechas o adjunta documentos)"
          rows="1"
          class="w-full bg-transparent px-3 py-1.5 resize-none focus:outline-none text-[var(--text-primary)] placeholder-[var(--text-muted)] text-[15px] leading-relaxed max-h-44 scrollbar-thin"
        ></textarea>

        <!-- Composer Toolbar (Controls on Left, Actions on Right) -->
        <div class="flex items-center justify-between px-1 sm:px-2 pt-0.5 gap-2 border-t border-[var(--border-subtle)]/40">
          
          <!-- Left: Redesigned Controls (Model Popover & Mode Chips) -->
          <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap min-w-0">
            
            <!-- 1. MODEL SELECTOR (ChatGPT-style Popover Trigger & Dropdown) -->
            <div class="relative" id="model-popover-wrapper">
              <!-- Trigger Pill Button -->
              <button
                type="button"
                id="model-popover-trigger"
                class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[var(--bg-primary)] hover:bg-[var(--border-subtle)]/70 text-[var(--text-primary)] border border-[var(--border-subtle)] shadow-2xs transition-all cursor-pointer select-none group"
                aria-haspopup="listbox"
                aria-expanded="false"
                title="Cambiar modelo de IA local"
              >
                <span class="text-amber-500 text-xs leading-none">⚡</span>
                <span id="current-model-name" class="font-medium tracking-tight truncate max-w-[120px] sm:max-w-[160px]">Qwen 2.5 0.5B</span>
                <span id="current-model-size" class="text-[10px] text-[var(--text-muted)] hidden md:inline font-mono">(~350 MB)</span>
                <svg
                  id="model-chevron"
                  class:list={[
                    'w-3 h-3 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-transform duration-200 shrink-0',
                    { 'rotate-180': showPopoverPreview }
                  ]}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Floating Popover Menu -->
              <div
                id="model-popover-menu"
                class:list={[
                  'absolute bottom-full left-0 mb-2 w-72 sm:w-80 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-2xl shadow-xl p-1.5 z-50 backdrop-blur-md',
                  { hidden: !showPopoverPreview }
                ]}
                role="listbox"
                aria-label="Seleccionar modelo local"
              >
                <div class="px-2.5 py-1.5 flex items-center justify-between border-b border-[var(--border-subtle)] mb-1">
                  <span class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">Modelos locales WebGPU</span>
                  <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded-full">100% privado</span>
                </div>

                <div class="space-y-0.5 max-h-64 overflow-y-auto scrollbar-thin">
                  {AVAILABLE_MODELS.map(m => (
                    <button
                      type="button"
                      class:list={[
                        'model-option-btn w-full text-left p-2 rounded-xl hover:bg-[var(--bg-secondary)] transition-all flex items-start justify-between gap-2 cursor-pointer group',
                        { 'bg-[var(--bg-secondary)]': m.id === AVAILABLE_MODELS[0].id }
                      ]}
                      data-model-id={m.id}
                      data-model-name={m.name}
                      data-model-size={m.size}
                      role="option"
                    >
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <span class="text-xs font-semibold text-[var(--text-primary)] group-hover:text-[var(--text-primary)]">{m.name}</span>
                          <span class="text-[10px] text-[var(--text-muted)] bg-[var(--bg-secondary)] group-hover:bg-[var(--bg-primary)] px-1.5 py-0.2 rounded border border-[var(--border-subtle)] font-mono">{m.size}</span>
                          {m.recommended && (
                            <span class="text-[9px] font-medium text-blue-600 dark:text-blue-400 bg-blue-500/10 px-1.5 py-0.2 rounded-full">Recomendado</span>
                          )}
                        </div>
                        <p class="text-[11px] text-[var(--text-muted)] line-clamp-1 mt-0.5 leading-snug">{m.description}</p>
                      </div>

                      <!-- Checkmark indicator icon -->
                      <div class:list={[
                        'model-check-icon shrink-0 mt-0.5 text-[var(--text-primary)] transition-opacity',
                        { 'opacity-0': m.id !== AVAILABLE_MODELS[0].id }
                      ]}>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </button>
                  ))}
                </div>

                <div class="px-2.5 py-1.5 text-[10px] text-[var(--text-muted)] border-t border-[var(--border-subtle)] mt-1 flex items-center justify-between">
                  <span>Ejecución local en tu GPU</span>
                  <span class="font-mono text-[9px]">WebLLM</span>
                </div>
              </div>
            </div>

            <!-- 2. SKILL SELECTOR (Skills.sh popover & auto mode toggle) -->
            <SkillPopover />

            <!-- 3. REFINEMENT LOOP TOGGLE (Planificar, Validar con Herramientas, Redactar y Pulir) -->
            <button
              type="button"
              id="refinement-toggle-btn"
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border shadow-2xs transition-all cursor-pointer select-none group bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30 hover:bg-amber-500/15"
              title="Loop de Razonamiento y Herramientas (Planifica, ejecuta herramientas deterministas, valida y pule)"
              aria-pressed="true"
            >
              <span class="text-xs leading-none select-none">🧠</span>
              <span class="font-medium tracking-tight">Refinamiento</span>
              <span id="refinement-indicator" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            </button>

            <!-- 4. ATTACH DOCUMENT BUTTON (Herramienta doc_reader) -->
            <label
              for="file-upload-input"
              id="attach-file-btn"
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border border-[var(--border-subtle)] bg-[var(--bg-primary)] hover:bg-[var(--border-subtle)]/70 text-[var(--text-secondary)] hover:text-[var(--text-primary)] shadow-2xs transition-all cursor-pointer select-none group"
              title="Adjuntar documento (.pdf, .txt, .md, .csv, .json, código) para lectura y análisis"
            >
              <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <span class="font-medium tracking-tight hidden sm:inline">Adjuntar</span>
              <input
                type="file"
                id="file-upload-input"
                class="hidden"
                accept=".pdf,.txt,.md,.markdown,.json,.csv,.js,.ts,.py,.html,.css,.xml"
                multiple
              />
            </label>
          </div>

          <!-- Right: Keyboard hints & Send/Stop Button -->
          <div class="flex items-center gap-2 shrink-0">
            <!-- Shortcut hints -->
            <div class="hidden lg:flex items-center gap-1.5 text-xs text-[var(--text-muted)] select-none">
              <span class="inline-flex items-center gap-1">
                <kbd class="px-1.5 py-0.5 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded text-[10px] text-[var(--text-secondary)] font-mono">Enter</kbd>
                <span class="text-[11px]">enviar</span>
              </span>
              <span class="inline-flex items-center gap-1">
                <kbd class="px-1.5 py-0.5 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded text-[10px] text-[var(--text-secondary)] font-mono">Shift+Enter</kbd>
                <span class="text-[11px]">línea</span>
              </span>
            </div>

            <!-- Circular Send / Stop Button -->
            <button
              type="submit"
              id="send-btn"
              disabled
              class="w-8 h-8 rounded-full flex items-center justify-center transition-all duration-150 bg-neutral-200 dark:bg-neutral-800 text-neutral-400 dark:text-neutral-500 cursor-not-allowed shrink-0"
              title="Enviar mensaje"
            >
              <!-- Send Icon (Up Arrow) -->
              <svg id="send-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              <!-- Stop Icon (Square) -->
              <svg id="stop-icon" class="w-3.5 h-3.5 hidden fill-current" viewBox="0 0 24 24">
                <rect x="5" y="5" width="14" height="14" rx="2" />
              </svg>
              <span id="send-text" class="sr-only">Enviar</span>
            </button>
          </div>

        </div>
      </div>
    </form>

    <!-- Quick Starter Suggestions (shown in empty state below composer) -->
    <div id="empty-suggestions" class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4 text-left animate-fade-in select-none">
      <button
        type="button"
        class="prompt-suggestion-btn p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] hover:border-[var(--text-muted)]/50 transition-all cursor-pointer text-xs sm:text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] shadow-2xs group flex flex-col gap-0.5"
        data-prompt="¿Cuánto es sqrt(65536) multiplicado por el 15% de 800 y qué fecha y hora tenemos hoy?"
      >
        <span class="font-medium text-[var(--text-primary)] flex items-center gap-1.5">
          <span>🛠️</span> Probar herramientas matemáticas y reloj
        </span>
        <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)]">Cálculo exacto determinista sin alucinaciones</span>
      </button>

      <button
        type="button"
        class="prompt-suggestion-btn p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] hover:border-[var(--text-muted)]/50 transition-all cursor-pointer text-xs sm:text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] shadow-2xs group flex flex-col gap-0.5"
        data-prompt="¿Cómo funciona la ejecución de modelos de IA locales dentro del navegador con WebGPU?"
      >
        <span class="font-medium text-[var(--text-primary)] flex items-center gap-1.5">
          <span>💡</span> Explicar IA en el navegador
        </span>
        <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)]">WebGPU y modelos cuantizados locales</span>
      </button>

      <button
        type="button"
        class="prompt-suggestion-btn p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] hover:border-[var(--text-muted)]/50 transition-all cursor-pointer text-xs sm:text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] shadow-2xs group flex flex-col gap-0.5"
        data-prompt="Escribe una función de TypeScript para hacer debounce y throttle con tipado estricto."
      >
        <span class="font-medium text-[var(--text-primary)] flex items-center gap-1.5">
          <span>💻</span> Escribir código TypeScript
        </span>
        <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)]">Función debounce con tipado seguro</span>
      </button>

      <button
        type="button"
        class="prompt-suggestion-btn p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] hover:border-[var(--text-muted)]/50 transition-all cursor-pointer text-xs sm:text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] shadow-2xs group flex flex-col gap-0.5"
        data-prompt="Dame 5 estrategias probadas para optimizar el rendimiento y la carga de una aplicación web moderna."
      >
        <span class="font-medium text-[var(--text-primary)] flex items-center gap-1.5">
          <span>⚡</span> Optimizar rendimiento web
        </span>
        <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)]">Estrategias clave de velocidad y UX</span>
      </button>
    </div>
  </div>
</div>
