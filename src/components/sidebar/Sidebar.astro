---
import ConversationList from './ConversationList.astro'

interface Props {
  initialConversations?: Array<{ id: string; title: string; isActive?: boolean }>
}

const { initialConversations = [] } = Astro.props
---

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-[260px] bg-[var(--bg-secondary)] border-r border-[var(--border-subtle)] flex flex-col transform -translate-x-full lg:translate-x-0 lg:static transition-all duration-200 ease-in-out shrink-0 select-none overflow-hidden"
>
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between px-3 py-3 border-b border-[var(--border-light)]">
    <!-- New Chat Button -->
    <button
      id="new-chat-sidebar"
      type="button"
      class="flex-1 flex items-center gap-2 px-3 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--border-subtle)]/60 rounded-lg transition-colors cursor-pointer group"
      title="Nuevo chat"
    >
      <svg class="w-4 h-4 text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      <span>Chat nuevo</span>
    </button>

    <!-- Collapse / Close Button -->
    <button
      id="close-sidebar"
      type="button"
      class="p-2 text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--border-subtle)]/60 rounded-lg transition-colors cursor-pointer"
      title="Cerrar barra lateral"
    >
      <!-- Sidebar icon for desktop, X for mobile -->
      <svg class="w-5 h-5 hidden lg:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v18" />
      </svg>
      <svg class="w-5 h-5 lg:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Conversations History -->
  <ConversationList initialConversations={initialConversations} />

  <!-- Skills Marketplace Action -->
  <div class="px-3 py-2 border-t border-[var(--border-light)]">
    <button
      id="open-skills-marketplace-btn"
      type="button"
      class="w-full flex items-center justify-between px-2.5 py-2 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--border-subtle)]/70 rounded-lg transition-colors cursor-pointer group"
      title="Abrir Skills Marketplace (skills.sh)"
    >
      <div class="flex items-center gap-2">
        <span class="text-indigo-500">🛍️</span>
        <span class="font-medium">Skills Marketplace</span>
      </div>
      <span id="sidebar-skills-count" class="text-[10px] font-mono px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-medium">
        4 activas
      </span>
    </button>
  </div>

  <!-- Sidebar Footer -->
  <div class="p-3 border-t border-[var(--border-light)] flex items-center justify-between text-xs text-[var(--text-muted)]">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="truncate">WebLLM · Local y privado</span>
    </div>
  </div>
</aside>

<!-- Mobile Overlay Backdrop -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/40 backdrop-blur-xs z-30 hidden lg:hidden transition-opacity duration-200"
></div>

<style>
  :global(#sidebar.sidebar-desktop-collapsed) {
    width: 0 !important;
    border-right-width: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    visibility: hidden;
  }
</style>
