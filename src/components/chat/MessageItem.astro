---
import type { ReasoningStep } from '../../scripts/chat/types'

interface Props {
  role: 'user' | 'assistant'
  content?: string
  isTemplate?: boolean
  reasoningSteps?: ReasoningStep[]
}

const { role, content = '', isTemplate = false, reasoningSteps = [] } = Astro.props

const isUser = role === 'user'
---

<li
  class:list={[
    'message w-full group transition-all duration-150',
    {
      'flex justify-end': isUser,
      'flex flex-col': !isUser,
      hidden: isTemplate,
    }
  ]}
  data-role={role}
>
  {isUser ? (
    <div class="user-bubble bg-[var(--user-msg-bg)] text-[var(--user-msg-text)] rounded-[22px] px-4 py-2.5 max-w-[85%] sm:max-w-[75%] text-[15px] leading-relaxed break-words shadow-2xs">
      <div class="message-content whitespace-pre-wrap">{content}</div>
    </div>
  ) : (
    <div class="assistant-wrapper w-full">
      {reasoningSteps && reasoningSteps.length > 0 && (
        <>
          <details class="reasoning-accordion group/reason text-xs">
            <summary class="flex items-center justify-between py-1 cursor-pointer select-none text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors">
              <div class="flex items-center gap-1.5">
                <span class="text-amber-500/80 text-xs">🧠</span>
                <span class="font-medium text-[11.5px] text-[var(--text-muted)] hover:text-[var(--text-secondary)]">Proceso de razonamiento y herramientas</span>
                <span class="text-[9px] px-1.5 py-0.2 rounded-full bg-[var(--bg-secondary)] border border-[var(--border-subtle)] text-[var(--text-muted)] font-mono opacity-80">{reasoningSteps.length} fases</span>
              </div>
              <div class="flex items-center gap-1.5 text-[var(--text-muted)] opacity-70">
                <svg class="w-3 h-3 group-open/reason:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <div class="w-full border-t border-[var(--border-subtle)]/60 my-1"></div>
            <div class="py-0.5 space-y-2">
              {reasoningSteps.map(step => (
                <div class="space-y-0.5">
                  <div class="flex items-center justify-between text-[11px] font-medium text-[var(--text-muted)]">
                    <span class="flex items-center gap-1.5 text-[var(--text-secondary)] font-medium">
                      {step.step === 'planning' && <span class="text-[11px]">📋</span>}
                      {step.step === 'tools' && <span class="text-[11px]">🛠️</span>}
                      {step.step === 'draft' && <span class="text-[11px]">📝</span>}
                      {step.step === 'validation' && <span class="text-[11px]">🔍</span>}
                      {step.step === 'refinement' && <span class="text-[11px]">✨</span>}
                      <span>{step.title}</span>
                    </span>
                    <span class="text-[9px] font-mono text-[var(--text-muted)] opacity-75 uppercase tracking-wider">
                      {step.step}
                    </span>
                  </div>
                  <div
                    class="step-markdown-content reasoning-prose pl-2 border-l border-amber-500/25 select-text"
                    data-content={encodeURIComponent(step.content)}
                  >
                    <div class="whitespace-pre-wrap">{step.content}</div>
                  </div>
                </div>
              ))}
            </div>
          </details>
          <hr class="border-t border-[var(--border-subtle)]/60 my-3" />
        </>
      )}

      <div class="message-content prose max-w-none text-[var(--text-primary)] text-[15px] sm:text-[16px] leading-[1.68]" set:html={content} />
      <div class="message-actions flex items-center gap-1 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
        <button
          type="button"
          class="copy-btn inline-flex items-center gap-1.5 px-2 py-1 text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--border-subtle)]/60 rounded-md transition-colors cursor-pointer"
          title="Copiar respuesta"
        >
          <svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="copy-text">Copiar</span>
        </button>
      </div>
    </div>
  )}
</li>
