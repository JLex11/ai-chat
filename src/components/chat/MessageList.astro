---
import MessageItem from './MessageItem.astro'
import TypingIndicator from './TypingIndicator.astro'
import type { Message } from '../../scripts/chat/types'

interface Props {
  initialMessages?: Message[]
}

const { initialMessages = [] } = Astro.props
const hasMessages = initialMessages.length > 0
---

<div
  id="messages"
  class="h-full w-full overflow-y-auto overflow-x-hidden px-4 sm:px-6 pt-16 sm:pt-20 pb-36 sm:pb-44 scrollbar-thin relative scroll-smooth"
>
  <div class="max-w-3xl mx-auto w-full flex flex-col justify-start">
    <!-- Empty State Header -->
    <div
      id="empty-state"
      class:list={[
        'flex flex-col items-center justify-center text-center select-none pt-4 pb-2 animate-fade-in',
        { hidden: hasMessages }
      ]}
    >
      <div class="w-12 h-12 rounded-2xl bg-[var(--bg-secondary)] border border-[var(--border-subtle)] flex items-center justify-center mb-4 shadow-2xs">
        <svg class="w-6 h-6 text-[var(--text-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--text-primary)] tracking-tight mb-2">
        ¿En qué puedo ayudarte hoy?
      </h2>
      <p class="text-sm text-[var(--text-secondary)] max-w-md">
        Modelos de IA ejecutados directamente en tu navegador. Tus conversaciones nunca salen de este equipo.
      </p>
    </div>

    <!-- Active Message List -->
    <ul id="message-list" class="space-y-6 w-full flex flex-col pt-2 pb-2">
      {initialMessages.map(msg => (
        <MessageItem
          role={msg.role as 'user' | 'assistant'}
          content={msg.content}
          reasoningSteps={msg.reasoningSteps}
        />
      ))}
    </ul>

    <!-- Typing Indicator (inside message stream) -->
    <TypingIndicator />
  </div>
</div>

<template id="message-template">
  <MessageItem role="user" isTemplate />
</template>
